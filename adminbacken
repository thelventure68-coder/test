def format_video_duration(seconds):
    seconds = max(0, int(seconds or 0))
    hours, remainder = divmod(seconds, 3600)
    minutes, secs = divmod(remainder, 60)
    if hours:
        return f"{hours}:{minutes:02d}:{secs:02d}"
    return f"{minutes}:{secs:02d}"


def create_duration_cover_from_bytes(photo_bytes: bytes, duration_seconds: int, drama_title: str):
    with Image.open(io.BytesIO(photo_bytes)) as source:
        image = source.convert("RGB")

    if int(duration_seconds or 0) > 0:
        overlay = Image.new("RGBA", image.size, (0, 0, 0, 0))
        draw = ImageDraw.Draw(overlay)
        duration_text = format_video_duration(duration_seconds)
        font_size = max(18, int(image.width * 0.045))

        try:
            font = ImageFont.truetype("DejaVuSans-Bold.ttf", font_size)
        except OSError:
            font = ImageFont.load_default()

        bbox = draw.textbbox((0, 0), duration_text, font=font)
        text_width = bbox[2] - bbox[0]
        text_height = bbox[3] - bbox[1]
        pad_x = max(10, int(image.width * 0.018))
        pad_y = max(6, int(image.width * 0.012))
        margin = max(12, int(image.width * 0.025))

        x2 = image.width - margin
        y2 = image.height - margin
        x1 = x2 - text_width - pad_x * 2
        y1 = y2 - text_height - pad_y * 2

        draw.rounded_rectangle(
            (x1, y1, x2, y2),
            radius=max(7, int(font_size * 0.22)),
            fill=(0, 0, 0, 220),
        )
        draw.text(
            (x1 + pad_x, y1 + pad_y - bbox[1]),
            duration_text,
            font=font,
            fill=(255, 255, 255, 255),
        )
        image = Image.alpha_composite(image.convert("RGBA"), overlay).convert("RGB")

    output = io.BytesIO()
    output.name = "duration_cover.jpg"
    image.save(output, format="JPEG", quality=92, optimize=True)
    output.seek(0)

    drama_code = ensure_drama_code(drama_title)
    return bot.send_photo(
        chat_id=CHANNEL_ID_VALUE,
        photo=output,
        caption=f"🖼️ Cover រឿង៖ {drama_title} [{drama_code}]",
    )


