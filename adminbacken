def ensure_drama_code(drama_title: str) -> str:
    clean_title = (drama_title or "").strip()
    if not clean_title or is_internal_key(clean_title):
        return ""

    code_map = get_all_codes_map_from_db()
    if clean_title in code_map:
        return code_map[clean_title]

    used_numbers = {parse_code_number(c) for c in code_map.values() if parse_code_number(c) > 0}
    next_num = (max(used_numbers) + 1) if used_numbers else 1
    while next_num in used_numbers:
        next_num += 1

    new_code = format_drama_code(next_num)
    save_drama_code_in_db(clean_title, new_code)
    return new_code


def sync_all_existing_drama_codes():
    try:
        ep_res = (
            supabase.table("episodes")
            .select("drama_title, channel_msg_id")
            .order("channel_msg_id", desc=False)
            .execute()
        )
        ordered_titles = []
        seen = set()
        for r in (ep_res.data or []):
            t = (r.get("drama_title") or "").strip()
            if t and not is_internal_key(t) and t not in seen:
                seen.add(t)
                ordered_titles.append(t)

        code_map = get_all_codes_map_from_db()
        used_numbers = {parse_code_number(c) for c in code_map.values() if parse_code_number(c) > 0}
        next_num = (max(used_numbers) + 1) if used_numbers else 1

        for t in ordered_titles:
            if t not in code_map:
                while next_num in used_numbers:
                    next_num += 1
                new_code = format_drama_code(next_num)
                used_numbers.add(next_num)
                code_map[t] = new_code
                save_drama_code_in_db(t, new_code)
    except Exception:
        log.warning("Could not sync existing drama codes at startup")


