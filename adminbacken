def ensure_webhook_active(force=False):
    global last_webhook_check
    if not WEBHOOK_URL.startswith("https://"):
        return

    now = time.time()
    if not force and (now - last_webhook_check < 60):
        return

    last_webhook_check = now
    try:
        info = bot.get_webhook_info()
        if info.url != WEBHOOK_URL:
            bot.set_webhook(
                url=WEBHOOK_URL,
                secret_token=WEBHOOK_SECRET,
                drop_pending_updates=False,
            )
            log.info("Webhook automatically restored to %s", WEBHOOK_URL)
    except Exception:
        log.exception("Failed to verify/restore webhook")


