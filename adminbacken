    raw = parse_drama_title(input_text)
    if not raw:
        return ""
    if raw.startswith("🔥 "):
        raw = raw[2:].strip()
    upper = raw.upper()
    if re.match(r"^XF-\d+$", upper) or (raw.isdigit() and len(raw) == 6):
        target_code = upper if upper.startswith("XF-") else f"XF-{int(raw):06d}"
        code_map = get_all_codes_map_from_db()
        for title, code in code_map.items():
            if code.upper() == target_code:
                return title
    return raw


