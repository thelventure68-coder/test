        # ប្ដូរឈ្មោះរូប Cover តាមភាគទាំងអស់
        ep_cov_rows = (
            supabase.table("drama_covers")
            .select("drama_title")
            .like("drama_title", f"{EP_COV_STORE_PREFIX}{old_title}__%")
            .execute()
        )
        old_ep_prefix = f"{EP_COV_STORE_PREFIX}{old_title}__"
        for r in (ep_cov_rows.data or []):
            old_k = r.get("drama_title") or ""
            if old_k.startswith(old_ep_prefix):
                ep_suffix = old_k[len(old_ep_prefix):]
                supabase.table("drama_covers").update(
                    {"drama_title": f"{EP_COV_STORE_PREFIX}{new_title}__{ep_suffix}"}
                ).eq("drama_title", old_k).execute()

        # ប្ដូរឈ្មោះក្នុង Top Trending បើមាន
        trending = get_top_trending_from_db()
        if old_title in trending:
            new_trending = [new_title if t == old_title else t for t in trending]
            save_top_trending_to_db(new_trending)

        supabase.table("user_history").update({"drama_title": new_title}).eq("drama_title", old_title).execute()
        supabase.table("user_history").update({"drama_title": f"{FAV_STORE_PREFIX}{new_title}"}).eq("drama_title", f"{FAV_STORE_PREFIX}{old_title}").execute()
        supabase.table("user_history").update({"drama_title": f"__RATE__{new_title}"}).eq("drama_title", f"__RATE__{old_title}").execute()
    except Exception:
        pass

    if existing_code:
        save_drama_code_in_db(new_title, existing_code)
    if existing_date:
        ensure_drama_upload_date(new_title, existing_date)

    return bool(ep_res.data or cov_res.data)


