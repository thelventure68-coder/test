def get_required_channel_config_from_db() -> tuple[int, str]:
    """ទាញយក Channel/Group ID និង Invite Link សម្រាប់លក្ខខណ្ឌតម្រូវឱ្យចូលមុនមើលរឿងពី Supabase"""
    cid = DEFAULT_REQ_CHANNEL_ID
    clink = DEFAULT_REQ_CHANNEL_LINK
    try:
        res = (
            supabase.table("drama_covers")
            .select("drama_title, cover_file_id")
            .in_(
                "drama_title",
                [CFG_REQ_CHANNEL_JSON_KEY, CFG_REQ_CHANNEL_ID_KEY, CFG_REQ_CHANNEL_LINK_KEY],
            )
            .execute()
        )
        for row in (res.data or []):
            k = (row.get("drama_title") or "").strip()
            val = (row.get("cover_file_id") or "").strip()
            if not val:
                continue
            if k == CFG_REQ_CHANNEL_JSON_KEY:
                try:
                    parsed = json.loads(val)
                    if isinstance(parsed, dict):
                        raw_id = str(parsed.get("channel_id") or "").strip()
                        raw_link = str(parsed.get("channel_link") or "").strip()
                        if raw_id.lstrip("-").isdigit():
                            cid = int(raw_id)
                        if raw_link.startswith(("http://", "https://", "tg://")):
                            clink = raw_link
                except Exception:
                    pass
            elif k == CFG_REQ_CHANNEL_ID_KEY and val.lstrip("-").isdigit():
                cid = int(val)
            elif k == CFG_REQ_CHANNEL_LINK_KEY and val.startswith(("http://", "https://", "tg://")):
                clink = val
    except Exception:
        log.warning("Could not load required channel config from Supabase; using defaults")
    return int(cid), str(clink)


def normalize_channel_link_input(raw_link: str) -> str:
    s = (raw_link or "").strip()
    if not s:
        return ""
    if s.startswith("@"):
        return f"https://t.me/{s.lstrip('@')}"
    if s.startswith("t.me/"):
        return f"https://{s}"
    if s.startswith(("http://", "https://", "tg://")):
        return s
    return ""


def _resolve_and_normalize_channel_id(raw_id: Optional[int], raw_link: Optional[str], fallback_id: int) -> tuple[int, str]:
    """
    Auto-normalizes Channel/Group ID (ensuring -100 prefix for supergroups/channels)
    and auto-detects the numeric chat.id if a public t.me/<username> link is provided.
    """
    resolved_id = int(raw_id) if raw_id is not None else int(fallback_id)
    resolved_link = (raw_link or "").strip()

    # 1. If a public link (https://t.me/username) was given, try to resolve its real chat.id via Telegram API
    if resolved_link:
        m_user = re.match(r"^(?:https?://)?(?:t\.me|telegram\.me)/([A-Za-z0-9_]{4,64})/?$", resolved_link)
        if m_user:
            uname = m_user.group(1)
            if uname.lower() not in {"joinchat", "addlist", "share", "c", "s"}:
                try:
                    chat_obj = bot.get_chat(f"@{uname}")
                    if chat_obj and getattr(chat_obj, "id", None):
                        resolved_id = int(chat_obj.id)
                except Exception:
                    pass

    # 2. If raw_id was given without -100 prefix, probe Telegram API to find the exact working chat.id
    if raw_id is not None:
        cid = int(raw_id)
        abs_str = str(abs(cid))
        candidates = []
        if abs_str.startswith("100") and len(abs_str) > 5:
            candidates.append(-int(abs_str))
        else:
            candidates.append(int(f"-100{abs_str}"))
        if cid not in candidates:
            candidates.append(cid)
        if -abs(cid) not in candidates:
            candidates.append(-abs(cid))

        resolved_id = candidates[0]
        for cand in candidates:
            try:
                chat_obj = bot.get_chat(cand)
                if chat_obj and getattr(chat_obj, "id", None):
                    resolved_id = int(chat_obj.id)
                    if not resolved_link:
                        if getattr(chat_obj, "username", None):
                            resolved_link = f"https://t.me/{chat_obj.username}"
                        elif getattr(chat_obj, "invite_link", None):
                            resolved_link = str(chat_obj.invite_link)
                    break
            except Exception:
                continue

    return int(resolved_id), resolved_link


def save_required_channel_config_to_db(
    channel_id: Optional[int] = None,
    channel_link: Optional[str] = None,
) -> tuple[int, str]:
    """រក្សាទុក Channel/Group ID និង Invite Link ចូលក្នុង Supabase ដោយស្វ័យប្រវត្តិ និងជូនដំណឹងទៅ User Backend"""
    cur_id, cur_link = get_required_channel_config_from_db()
    norm_link = normalize_channel_link_input(channel_link) if channel_link is not None else cur_link
    if not norm_link:
        norm_link = cur_link
    new_id, auto_link = _resolve_and_normalize_channel_id(channel_id, norm_link, cur_id)
    new_link = auto_link or norm_link or cur_link

    try:
        supabase.table("drama_covers").upsert(
            [
                {
                    "drama_title": CFG_REQ_CHANNEL_ID_KEY,
                    "cover_file_id": str(new_id),
                    "cover_channel_msg_id": 0,
                },
                {
                    "drama_title": CFG_REQ_CHANNEL_LINK_KEY,
                    "cover_file_id": new_link,
                    "cover_channel_msg_id": 0,
                },
                {
                    "drama_title": CFG_REQ_CHANNEL_JSON_KEY,
                    "cover_file_id": json.dumps(
                        {"channel_id": new_id, "channel_link": new_link},
                        ensure_ascii=False,
                    ),
                    "cover_channel_msg_id": 0,
                },
            ],
            on_conflict="drama_title",
        ).execute()
    except Exception:
        log.exception("Failed to save required channel config to Supabase")

    base_url = get_resolved_mini_app_url()
    if base_url:
        try:
            requests.post(
                f"{base_url}/api/internal/channel-config",
                json={"channel_id": new_id, "channel_link": new_link},
                timeout=5,
            )
        except Exception:
            pass

    return new_id, new_link


