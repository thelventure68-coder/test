def delete_entire_drama_in_db(drama_title):
    eps = (
        supabase.table("episodes")
        .select("channel_msg_id")
        .eq("drama_title", drama_title)
        .execute()
    )
    cov_keys = [
        drama_title,
        f"{GIF_STORE_PREFIX}{drama_title}",
        f"{ALBUM_STORE_PREFIX}{drama_title}__1",
        f"{ALBUM_STORE_PREFIX}{drama_title}__2",
        f"{ALBUM_STORE_PREFIX}{drama_title}__3",
    ]
    cov = (
        supabase.table("drama_covers")
        .select("cover_channel_msg_id")
        .in_("drama_title", cov_keys)
        .execute()
    )
    ep_covs = (
        supabase.table("drama_covers")
        .select("drama_title, cover_channel_msg_id")
        .like("drama_title", f"{EP_COV_STORE_PREFIX}{drama_title}__%")
        .execute()
    )

    if not eps.data and not cov.data:
        return False, f"❌ រកមិនឃើញរឿងឈ្មោះ «{drama_title}» នៅក្នុងប្រព័ន្ធទេ។"

    for row in (eps.data or []):
        msg_id = row.get("channel_msg_id")
        if msg_id:
            safe_delete_message(CHANNEL_ID_VALUE, int(msg_id))

    for row in (cov.data or []):
        c_id = row.get("cover_channel_msg_id")
        if c_id:
            safe_delete_message(CHANNEL_ID_VALUE, int(c_id))

    for row in (ep_covs.data or []):
        ec_id = row.get("cover_channel_msg_id")
        if ec_id:
            safe_delete_message(CHANNEL_ID_VALUE, int(ec_id))

    supabase.table("episodes").delete().eq("drama_title", drama_title).execute()
    supabase.table("drama_covers").delete().in_("drama_title", cov_keys).execute()
    try:
        supabase.table("drama_covers").delete().like("drama_title", f"{EP_COV_STORE_PREFIX}{drama_title}__%").execute()

        # Remove notification watch tokens that point to the deleted drama.
        # Tokens are stored as __NOTIF_WATCH__<token>; their target is JSON in cover_file_id.
        watch_rows = (
            supabase.table("drama_covers")
            .select("drama_title, cover_file_id")
            .like("drama_title", "__NOTIF_WATCH__%")
            .execute()
        )
        stale_watch_keys = []
        for watch_row in (watch_rows.data or []):
            watch_key = str(watch_row.get("drama_title") or "")
            if not watch_key.startswith("__NOTIF_WATCH__"):
                continue
            try:
                watch_payload = json.loads(watch_row.get("cover_file_id") or "{}")
            except (TypeError, ValueError):
                continue
            if (
                isinstance(watch_payload, dict)
                and str(watch_payload.get("drama_title") or "").strip() == drama_title
            ):
                stale_watch_keys.append(watch_key)

        if stale_watch_keys:
            supabase.table("drama_covers").delete().in_(
                "drama_title", stale_watch_keys
            ).execute()
        for prefix in [
            SYN_STORE_PREFIX,
            LANG_STORE_PREFIX,
            CODE_STORE_PREFIX,
            DATE_STORE_PREFIX,
            DUR_STORE_PREFIX,
            TAGS_STORE_PREFIX,
            GIF_STORE_PREFIX,
        ]:
            supabase.table("drama_covers").delete().eq("drama_title", f"{prefix}{drama_title}").execute()

        trending = get_top_trending_from_db()
        if drama_title in trending:
            save_top_trending_to_db([t for t in trending if t != drama_title])

        supabase.table("user_history").delete().eq("drama_title", drama_title).execute()
        supabase.table("user_history").delete().eq("drama_title", f"{FAV_STORE_PREFIX}{drama_title}").execute()
        supabase.table("user_history").delete().eq("drama_title", f"__RATE__{drama_title}").execute()
    except Exception:
        pass

    return True, f"🗑️ បានលុបរឿង «{drama_title}» ទាំងមូលចេញពីប្រព័ន្ធ និង Channel បានជោគជ័យ!"


