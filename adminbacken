def drama_pagination_keyboard(dramas, page=0, per_page=10, highlight_set: set = None):
    markup = ReplyKeyboardMarkup(resize_keyboard=True, row_width=2)
    total_pages = max(1, (len(dramas) + per_page - 1) // per_page)
    page = max(0, min(page, total_pages - 1))

    start = page * per_page
    end = start + per_page
    current_slice = dramas[start:end]

    for i in range(0, len(current_slice), 2):
        row_btns = []
        for t in current_slice[i:i+2]:
            label = f"🔥 {t}" if (highlight_set and t in highlight_set) else t
            row_btns.append(KeyboardButton(label))
        markup.row(*row_btns)

    nav_btns = []
    if page > 0:
        nav_btns.append(KeyboardButton(BTN_PREV_PAGE))
    if end < len(dramas):
        nav_btns.append(KeyboardButton(BTN_NEXT_PAGE))
    if nav_btns:
        markup.row(*nav_btns)

    markup.row(KeyboardButton(BTN_CANCEL))
    return markup, page, total_pages


def safe_delete_message(chat_id, message_id):
    try:
        bot.delete_message(chat_id, message_id)
    except Exception:
        pass


def track_message_for_cleanup(user_id, message_id):
    if user_id not in chat_cleanup_ids:
        chat_cleanup_ids[user_id] = set()
    chat_cleanup_ids[user_id].add(message_id)


def clear_previous_messages(chat_id, user_id):
    msg_ids = chat_cleanup_ids.get(user_id, set()).copy()
    chat_cleanup_ids[user_id] = set()
    for mid in msg_ids:
        safe_delete_message(chat_id, mid)


def send_clean_message(message, text, reply_markup=None, delete_user_msg=True):
    user_id = message.from_user.id
    chat_id = message.chat.id

    sent = None
    try:
        sent = bot.send_message(chat_id, text, reply_markup=reply_markup)
    except Exception:
        log.exception("Could not send Telegram message")

    if delete_user_msg:
        safe_delete_message(chat_id, message.message_id)
    else:
        track_message_for_cleanup(user_id, message.message_id)

    clear_previous_messages(chat_id, user_id)

    if sent:
        track_message_for_cleanup(user_id, sent.message_id)
    return sent


def send_frame_candidates_to_admin(chat_id: int, user_id: int, frames_list: list[bytes]):
    if not frames_list:
        return
    try:
        media_group = []
        for idx, f_bytes in enumerate(frames_list[:5], start=1):
            bio = io.BytesIO(f_bytes)
            bio.name = f"frame_{idx}.jpg"
            media_group.append(
                InputMediaPhoto(
                    media=bio,
                    caption=f"🖼️ រូបទី {idx}",
                )
            )
        sent_msgs = bot.send_media_group(chat_id=chat_id, media=media_group)
        for m in (sent_msgs or []):
            track_message_for_cleanup(user_id, m.message_id)
    except Exception:
        log.warning("Could not send media group frames, falling back to single photos")
        for idx, f_bytes in enumerate(frames_list[:5], start=1):
            try:
                bio = io.BytesIO(f_bytes)
                bio.name = f"frame_{idx}.jpg"
                s = bot.send_photo(chat_id=chat_id, photo=bio, caption=f"🖼️ រូបទី {idx}")
                track_message_for_cleanup(user_id, s.message_id)
            except Exception:
                pass


