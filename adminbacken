                        bio = io.BytesIO(cover_bytes)
                        bio.name = "cover.jpg"
                        sent_msg = user_bot_client.send_photo(
                            chat_id=uid,
                            photo=bio,
                            caption=caption_text,
                            parse_mode="HTML",
                            reply_markup=markup,
                        )
                        if getattr(sent_msg, "photo", None):
                            cached_user_bot_photo_id = sent_msg.photo[-1].file_id
                        delivered = True
                    except Exception:
                        delivered = False

                if not delivered and cover_msg_id:
                    try:
                        user_bot_client.copy_message(
                            chat_id=uid,
                            from_chat_id=CHANNEL_ID_VALUE,
                            message_id=int(cover_msg_id),
                            caption=caption_text,
                            parse_mode="HTML",
                            reply_markup=markup,
                        )
                        delivered = True
                    except Exception:
                        delivered = False

