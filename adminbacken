            "drama_title": key,
            "cover_file_id": clean_code,
            "cover_channel_msg_id": 0,
        }
        if res.data:
            supabase.table("drama_covers").update(payload).eq("drama_title", key).execute()
        else:
            supabase.table("drama_covers").insert(payload).execute()
