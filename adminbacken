            escaped_title = html.escape(drama_title)
            escaped_code = html.escape(drama_code or "XF-000001")
            caption_text = (
                f"🔥 <b>រឿងថ្មីទើបមកដល់ក្នុង {CHANNEL_DISPLAY_NAME}!</b>\n"
