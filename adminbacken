def get_notification_stats_from_db() -> dict:
    default_stats = {
        "total_broadcasts": 0,
        "total_delivered": 0,
        "total_failed": 0,
        "last_drama": "មិនទាន់មាន",
        "last_sent_ok": 0,
        "last_failed": 0,
