def format_drama_code(num: int) -> str:
    return f"XF-{int(num):06d}"


def parse_code_number(code_str: str) -> int:
    if not code_str:
        return 0
    m = re.match(r"^XF-(\d+)$", str(code_str).strip().upper())
    if m:
        return int(m.group(1))
    return 0


def get_all_codes_map_from_db() -> dict[str, str]:
    code_map = {}
    try:
        res = (
            supabase.table("drama_covers")
            .select("drama_title, cover_file_id")
            .like("drama_title", f"{CODE_STORE_PREFIX}%")
            .execute()
        )
        for r in (res.data or []):
            k = (r.get("drama_title") or "").strip()
            val = (r.get("cover_file_id") or "").strip().upper()
            if k.startswith(CODE_STORE_PREFIX) and val.startswith("XF-"):
                real_title = k[len(CODE_STORE_PREFIX):].strip()
                if real_title:
                    code_map[real_title] = val
    except Exception:
        log.warning("Could not fetch __CODE__ rows")

    try:
        res_col = (
            supabase.table("drama_covers")
            .select("drama_title, drama_code")
            .execute()
        )
        for r in (res_col.data or []):
            t = (r.get("drama_title") or "").strip()
            c = (r.get("drama_code") or "").strip().upper()
            if t and not is_internal_key(t) and c.startswith("XF-") and t not in code_map:
                code_map[t] = c
    except Exception:
        pass

    return code_map


def save_drama_code_in_db(drama_title: str, drama_code: str) -> str:
    clean_title = (drama_title or "").strip()
    clean_code = (drama_code or "").strip().upper()
    if not clean_title or not clean_code:
        return clean_code

    key = f"{CODE_STORE_PREFIX}{clean_title}"
    try:
        res = (
