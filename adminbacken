def clean_category_text(text):
    if not text:
        return ""
    for prefix in ["🇨🇳 ", "🇰🇭 ", "🤖 ", "🇰🇷 ", "✨ ", "🇨🇳", "🇰🇭", "🤖", "🇰🇷", "✨"]:
        text = text.replace(prefix, "")
    c = text.strip()
    if c == "រឿងភាគចិន":
        return "រឿងចិន"
    if c == "រឿងភាគខ្មែរ":
        return "រឿងខ្មែរ"
    if c == "រឿងភាគកូរ៉េ":
        return "រឿងកូរ៉េ"
    return c


def get_category_variants(cat_name):
    clean = clean_category_text(cat_name)
    variants = {cat_name.strip(), clean}
    mapping = {
        "រឿងចិន": ["🇨🇳 រឿងចិន", "🇨🇳រឿងចិន", "រឿងភាគចិន"],
        "រឿងខ្មែរ": ["🇰🇭 រឿងខ្មែរ", "🇰🇭រឿងខ្មែរ", "រឿងភាគខ្មែរ"],
        "រឿងAI": ["🤖 រឿងAI", "🤖រឿងAI", "រឿង AI"],
        "រឿងកូរ៉េ": ["🇰🇷 រឿងកូរ៉េ", "🇰🇷រឿងកូរ៉េ", "រឿងភាគកូរ៉េ"],
        "ផ្សេងៗ": ["✨ ផ្សេងៗ", "✨ផ្សេងៗ"],
    }
    if clean in mapping:
        variants.update(mapping[clean])
    return list(variants)


