            supabase.table("drama_covers")
            .select("cover_file_id")
            .eq("drama_title", NOTIF_STATS_KEY)
            .limit(1)
            .execute()
        )
        if res.data and res.data[0].get("cover_file_id"):
            parsed = json.loads(res.data[0]["cover_file_id"])
