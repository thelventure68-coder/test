# AUTO COVER EXTRACTOR (3-5 FRAMES) & GIF PREVIEW (3-5s)
# =====================================================

def build_gif_from_pil_frames(pil_frames: list[Image.Image], frame_duration_ms: int = 140) -> Optional[bytes]:
    if not pil_frames:
        return None
    try:
        processed = []
        target_w = 320
        for im in pil_frames:
            rgb = im.convert("RGB")
            w, h = rgb.size
            if w > 0 and h > 0:
                target_h = max(180, int(h * (target_w / w)))
                resized = rgb.resize((target_w, target_h), Image.Resampling.LANCZOS)
                quantized = resized.quantize(colors=128, method=Image.Quantize.FASTOCTREE)
                processed.append(quantized)
        if not processed:
            return None
        out = io.BytesIO()
        processed[0].save(
            out,
            format="GIF",
            save_all=True,
            append_images=processed[1:],
            duration=frame_duration_ms,
            loop=0,
            optimize=True,
        )
        return out.getvalue()
    except Exception:
        log.exception("Failed to assemble GIF from PIL frames")
        return None


def generate_fallback_frames_and_gif_from_image(base_img_bytes: bytes) -> tuple[list[bytes], Optional[bytes]]:
    frames_bytes = []
    gif_bytes = None
    try:
        with Image.open(io.BytesIO(base_img_bytes)) as src:
            base = src.convert("RGB")

        variations = [
            base,
            ImageEnhance.Color(ImageEnhance.Contrast(base).enhance(1.12)).enhance(1.18),
            ImageEnhance.Brightness(ImageEnhance.Contrast(base).enhance(1.15)).enhance(1.06),
        ]
        w, h = base.size
        if w > 40 and h > 40:
            crop_box = (int(w * 0.06), int(h * 0.06), int(w * 0.94), int(h * 0.94))
            variations.append(base.crop(crop_box).resize((w, h), Image.Resampling.LANCZOS))

        for var_im in variations[:4]:
            buf = io.BytesIO()
            var_im.save(buf, format="JPEG", quality=90)
            frames_bytes.append(buf.getvalue())

        anim_frames = []
        steps = 14
        for i in range(steps):
            scale = i / float(steps - 1) * 0.10
            dx = int(w * scale * 0.5)
            dy = int(h * scale * 0.5)
            cropped = base.crop((dx, dy, w - dx, h - dy)).resize((w, h), Image.Resampling.LANCZOS)
            anim_frames.append(cropped)
        full_loop = anim_frames + list(reversed(anim_frames[1:-1]))
        gif_bytes = build_gif_from_pil_frames(full_loop, frame_duration_ms=145)
    except Exception:
        log.exception("Fallback frame/GIF generation failed")

    return frames_bytes, gif_bytes


def extract_single_frame_from_video_message(message) -> Optional[bytes]:
    """ទាញយករូបភាព ១ សន្លឹកពីវីដេអូសម្រាប់ធ្វើជា Cover ភាគរឿង (Episode Cover)"""
    thumb_file_id = None
    file_id = None
    file_size = 0

    if message.content_type == "video" and getattr(message, "video", None):
        v = message.video
        file_id = v.file_id
        file_size = int(v.file_size or 0)
        if getattr(v, "thumbnail", None):
            thumb_file_id = v.thumbnail.file_id
        elif getattr(v, "thumb", None):
            thumb_file_id = v.thumb.file_id
    elif message.content_type == "document" and getattr(message, "document", None):
        d = message.document
        file_id = d.file_id
        file_size = int(d.file_size or 0)
        if getattr(d, "thumbnail", None):
            thumb_file_id = d.thumbnail.file_id
        elif getattr(d, "thumb", None):
            thumb_file_id = d.thumb.file_id

    if thumb_file_id:
        try:
            t_info = bot.get_file(thumb_file_id)
            t_bytes = bot.download_file(t_info.file_path)
            if t_bytes:
                return t_bytes
        except Exception:
            pass

    if file_id and (file_size == 0 or file_size <= 19_800_000) and cv2 is not None:
        tmp_path = None
        try:
            f_info = bot.get_file(file_id)
            v_bytes = bot.download_file(f_info.file_path)
            with tempfile.NamedTemporaryFile(suffix=".mp4", delete=False) as tmp:
                tmp.write(v_bytes)
                tmp_path = tmp.name

            cap = cv2.VideoCapture(tmp_path)
            total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT) or 0)
            if total_frames > 2:
                target_idx = max(0, min(total_frames - 1, int(total_frames * 0.25)))
                cap.set(cv2.CAP_PROP_POS_FRAMES, target_idx)
                ok, frame = cap.read()
                if ok and frame is not None:
                    rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
                    pil_img = Image.fromarray(rgb)
                    buf = io.BytesIO()
                    pil_img.save(buf, format="JPEG", quality=90)
                    cap.release()
                    return buf.getvalue()
            cap.release()
        except Exception:
            pass
        finally:
            if tmp_path and os.path.exists(tmp_path):
                try:
                    os.remove(tmp_path)
                except Exception:
                    pass

    return None


def extract_video_frames_and_gif(message) -> tuple[list[bytes], Optional[bytes]]:
    file_id = None
    file_size = 0
    thumb_file_id = None

    if message.content_type == "video" and getattr(message, "video", None):
        v = message.video
        file_id = v.file_id
        file_size = int(v.file_size or 0)
        if getattr(v, "thumbnail", None):
            thumb_file_id = v.thumbnail.file_id
        elif getattr(v, "thumb", None):
            thumb_file_id = v.thumb.file_id
    elif message.content_type == "document" and getattr(message, "document", None):
        d = message.document
        file_id = d.file_id
        file_size = int(d.file_size or 0)
        if getattr(d, "thumbnail", None):
            thumb_file_id = d.thumbnail.file_id
        elif getattr(d, "thumb", None):
            thumb_file_id = d.thumb.file_id

    frames_bytes = []
    gif_bytes = None

    if file_id and (file_size == 0 or file_size <= 19_800_000) and cv2 is not None:
        tmp_path = None
        try:
            f_info = bot.get_file(file_id)
            v_bytes = bot.download_file(f_info.file_path)
            with tempfile.NamedTemporaryFile(suffix=".mp4", delete=False) as tmp:
                tmp.write(v_bytes)
                tmp_path = tmp.name

            cap = cv2.VideoCapture(tmp_path)
            total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT) or 0)
            fps = float(cap.get(cv2.CAP_PROP_FPS) or 25.0)
            if fps <= 1 or fps > 120:
                fps = 25.0

            if total_frames > 5:
                ratios = [0.15, 0.38, 0.62, 0.85]
                for r in ratios:
                    target_idx = max(0, min(total_frames - 1, int(total_frames * r)))
                    cap.set(cv2.CAP_PROP_POS_FRAMES, target_idx)
                    ok, frame = cap.read()
                    if ok and frame is not None:
                        rgb = cv2.cvtColor(frame, cv2.cvtColor(frame, cv2.COLOR_BGR2RGB) if False else cv2.COLOR_BGR2RGB)
                        pil_img = Image.fromarray(rgb)
                        buf = io.BytesIO()
                        pil_img.save(buf, format="JPEG", quality=92)
                        frames_bytes.append(buf.getvalue())

                gif_start_frame = int(total_frames * 0.20)
                gif_span_frames = min(int(fps * 4.0), max(10, total_frames - gif_start_frame - 1))
                num_gif_samples = 28
                step = max(1, gif_span_frames // num_gif_samples)

                pil_gif_frames = []
                for i in range(num_gif_samples):
                    f_idx = min(total_frames - 1, gif_start_frame + i * step)
                    cap.set(cv2.CAP_PROP_POS_FRAMES, f_idx)
                    ok, frame = cap.read()
                    if ok and frame is not None:
                        rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
                        pil_gif_frames.append(Image.fromarray(rgb))

                gif_bytes = build_gif_from_pil_frames(pil_gif_frames, frame_duration_ms=140)

            cap.release()
        except Exception:
            log.warning("Direct video CV2 extraction skipped/failed, trying thumbnail fallback.")
        finally:
            if tmp_path and os.path.exists(tmp_path):
                try:
                    os.remove(tmp_path)
                except Exception:
                    pass

    if (not frames_bytes or not gif_bytes) and thumb_file_id:
        try:
            t_info = bot.get_file(thumb_file_id)
            t_bytes = bot.download_file(t_info.file_path)
            fb_frames, fb_gif = generate_fallback_frames_and_gif_from_image(t_bytes)
            if not frames_bytes:
                frames_bytes = fb_frames
            if not gif_bytes:
                gif_bytes = fb_gif
        except Exception:
            log.warning("Thumbnail fallback failed")

    return frames_bytes, gif_bytes


