def get_all_started_user_ids() -> list[int]:
    uids = set()
    try:
        res = supabase.table("user_history").select("user_id, drama_title").execute()
        for r in (res.data or []):
            uid = r.get("user_id")
            t = str(r.get("drama_title") or "")
            if uid is not None:
                uid_int = int(uid)
                if uid_int > 100000 and not (t.startswith("__RATE__") and uid_int < 100000000):
                    uids.add(uid_int)
    except Exception:
        log.exception("Could not fetch started user IDs")
    return sorted(list(uids))


def compute_admin_user_analytics() -> dict:
    today_int = get_cambodia_date_int()
    seven_days_ago_int = int((get_cambodia_now() - timedelta(days=7)).strftime("%Y%m%d"))
    today_iso_prefix = get_cambodia_now().strftime("%Y-%m-%d")

    all_users = set()
    new_users_today = set()
    new_users_7d = set()
    active_today = set()

    try:
        res = supabase.table("user_history").select("user_id, drama_title, last_ep, updated_at").execute()
        for r in (res.data or []):
            uid = r.get("user_id")
            if not uid:
                continue
            uid_int = int(uid)
            t = str(r.get("drama_title") or "")
            if t.startswith("__RATE__") and uid_int < 100000000:
                continue

            all_users.add(uid_int)

            if t == USER_START_KEY:
                join_date_int = int(r.get("last_ep") or 0)
                if join_date_int == today_int:
                    new_users_today.add(uid_int)
                if join_date_int >= seven_days_ago_int:
                    new_users_7d.add(uid_int)

            updated_raw = str(r.get("updated_at") or "")
            if updated_raw.startswith(today_iso_prefix):
                active_today.add(uid_int)
    except Exception:
        log.exception("Error computing user analytics")

    total_dramas = len(get_all_drama_titles())
    total_episodes = 0
    try:
        ep_res = supabase.table("episodes").select("ep_number").execute()
        total_episodes = len(ep_res.data or [])
    except Exception:
        pass

    notif_stats = get_notification_stats_from_db()

    return {
        "total_users": len(all_users),
        "new_users_today": len(new_users_today),
        "new_users_7d": len(new_users_7d),
        "active_users_today": len(active_today),
        "total_dramas": total_dramas,
        "total_episodes": total_episodes,
        "notif_stats": notif_stats,
    }


def create_notification_watch_token_for_user_bot(drama_title: str) -> Optional[str]:
    """Create a callback token compatible with the User Bot notification handler."""
    try:
        episodes_res = (
            supabase.table("episodes")
            .select("ep_number, channel_msg_id")
            .eq("drama_title", drama_title)
            .order("ep_number", desc=False)
            .limit(1000)
            .execute()
        )
        first_video_ep = next(
            (
                row for row in (episodes_res.data or [])
                if row.get("channel_msg_id") and int(row.get("ep_number") or 0) > 0
            ),
            None,
        )
        if not first_video_ep:
            log.warning("No available video episode for notification: %s", drama_title)
            return None

        token = secrets.token_hex(5)
        key = f"__NOTIF_WATCH__{token}"
        payload = {
            "drama_title": key,
            "cover_file_id": json.dumps(
                {
                    "drama_title": drama_title,
                    "ep_number": int(first_video_ep["ep_number"]),
                },
                ensure_ascii=False,
            ),
            "cover_channel_msg_id": 0,
        }
        supabase.table("drama_covers").upsert(
            payload, on_conflict="drama_title"
        ).execute()
        return token
    except Exception:
        log.exception("Could not create notification watch token for %s", drama_title)
        return None


def enqueue_notification_for_user_bot(
    drama_title: str,
    admin_chat_id: int,
    custom_cover_msg_id: Optional[int] = None,
    custom_cover_file_id: Optional[str] = None,
) -> bool:
    """បញ្ជូន Queue ឱ្យ User Bot (backenuser.py) ជាអ្នកផ្ញើចូល User Bot Chat ផ្ទាល់ (គាំទ្ររូប Cover ថ្មី ឬ Cover ស្រាប់)"""
    try:
        job = {
            "drama_title": drama_title,
            "admin_chat_id": int(admin_chat_id),
            "custom_cover_msg_id": int(custom_cover_msg_id) if custom_cover_msg_id else None,
            "custom_cover_file_id": custom_cover_file_id or None,
            "timestamp": time.time(),
        }
        serialized = json.dumps(job, ensure_ascii=False)
        res = (
            supabase.table("drama_covers")
            .select("drama_title")
            .eq("drama_title", CFG_NOTIF_QUEUE_KEY)
            .limit(1)
            .execute()
        )
        payload = {
            "drama_title": CFG_NOTIF_QUEUE_KEY,
            "cover_file_id": serialized,
            "cover_channel_msg_id": 0,
        }
        if res.data:
            supabase.table("drama_covers").update(payload).eq("drama_title", CFG_NOTIF_QUEUE_KEY).execute()
        else:
            supabase.table("drama_covers").insert(payload).execute()

        base_url = get_resolved_mini_app_url()
        if base_url:
            try:
                requests.post(
                    f"{base_url}/api/internal/broadcast-notification",
                    json={
                        "drama_title": drama_title,
                        "admin_chat_id": int(admin_chat_id),
                        "custom_cover_msg_id": int(custom_cover_msg_id) if custom_cover_msg_id else None,
                        "custom_cover_file_id": custom_cover_file_id or None,
                    },
                    timeout=5,
                )
            except Exception:
                pass
        return True
    except Exception:
        log.exception("Failed to enqueue notification for User Bot")
        return False


def broadcast_new_drama_notification_async(
    drama_title: str,
    admin_chat_id: int,
    custom_cover_bytes: Optional[bytes] = None,
    custom_cover_msg_id: Optional[int] = None,
):
    """
    Point 3.2: ផ្ញើ Notification រឿងថ្មីទៅកាន់ User Bot Chat ជារូប Cover (អាចប្រើរូប Cover ដែល Admin ទើប Upload ថ្មី
    ឬរូប Cover រឿងដែលមានស្រាប់) ភ្ជាប់ជាមួយ ចំណងជើងរឿង + លេខកូដ (ឧ. XF-000001) និងប៊ូតុង ▶️ មើលឥឡូវនេះ។
    """
    def _worker():
        try:
            real_user_bot_token = get_resolved_user_bot_token()
            drama_code = ensure_drama_code(drama_title)

            # បើ Admin បាន Upload រូប Cover ថ្មីសម្រាប់ Notification បង្ហោះចូល Channel ដើម្បីទុក Message ID ឱ្យ User Bot ប្រើបានដែរ
            notif_channel_msg_id = int(custom_cover_msg_id) if custom_cover_msg_id else None
            if custom_cover_bytes and not notif_channel_msg_id:
                try:
                    bio_ch = io.BytesIO(custom_cover_bytes)
                    bio_ch.name = "notif_cover.jpg"
                    sent_ch = bot.send_photo(
                        chat_id=CHANNEL_ID_VALUE,
                        photo=bio_ch,
                        caption=f"🔔 Notification Cover៖ {drama_title} [{drama_code}]",
                    )
                    if sent_ch:
                        notif_channel_msg_id = int(sent_ch.message_id)
                except Exception:
                    log.warning("Could not upload custom notification cover to channel")

            # ប្រសិនបើមិនទាន់មាន USER_BOT_TOKEN ដាច់ដោយឡែកទេ បញ្ជូនទៅឱ្យ backenuser.py ផ្ញើតាម User Bot ផ្ទាល់
            if not real_user_bot_token:
                ok = enqueue_notification_for_user_bot(
                    drama_title=drama_title,
                    admin_chat_id=admin_chat_id,
                    custom_cover_msg_id=notif_channel_msg_id,
                )
                if ok:
                    bot.send_message(
                        admin_chat_id,
                        f"📨 សំណើផ្ញើ Notification សម្រាប់រឿង «{drama_title}» ({drama_code}) ត្រូវបានបញ្ជូនទៅកាន់ **User Bot** រួចរាល់!\n"
                        "User Bot កំពុងផ្ញើរូប Cover ភ្ជាប់ចំណងជើង និង ID Code ចូលទៅកាន់ប្រអប់ឆាតរបស់អ្នកប្រើប្រាស់គ្រប់គ្នា។",
                        reply_markup=main_menu_keyboard(),
                    )
                else:
                    bot.send_message(
                        admin_chat_id,
                        "⚠️ សូមបើកដំណើរការ User Bot (backenuser.py) ឬកំណត់ USER_BOT_TOKEN ដើម្បីផ្ញើ Notification ទៅកាន់ User Bot Chat។",
                        reply_markup=main_menu_keyboard(),
                    )
                return

            user_bot_client = telebot.TeleBot(real_user_bot_token, threaded=False)
            user_ids = get_all_started_user_ids()
            dur = get_drama_duration_from_db(drama_title)
