                mode_label = "💥 លុបរឿងទាំងមូល" if state["delete_mode"] == "ALL" else "✂️ លុបតែមួយភាគ"

                send_clean_message(
                    message,
                    f"{mode_label}\n"
                    f"📄 ទំព័រទី {cur_page + 1} / {total_pages} (សរុប {len(dramas)} រឿង)\n\n"
                    "👇 សូមចុចជ្រើសរើស **ឈ្មោះរឿង** (ឬវាយ CODE) ដែលអ្នកចង់លុប៖",
                    reply_markup=kb,
                )
                return

            send_clean_message(
                message,
                "សូមជ្រើសរើសតាមប៊ូតុងខាងក្រោម៖",
                reply_markup=delete_menu_keyboard(),
            )
            return

        if step == "DEL_SELECT_DRAMA_PAGE":
            dramas = state.get("dramas_list") or []
            page = state.get("page", 0)

            if text == BTN_NEXT_PAGE:
                page += 1
                kb, cur_page, total_pages = drama_pagination_keyboard(dramas, page, 10)
                state["page"] = cur_page
                send_clean_message(
                    message,
                    f"📄 ទំព័រទី {cur_page + 1} / {total_pages} (សរុប {len(dramas)} រឿង)\n"
                    "👇 សូមចុចជ្រើសរើស **ឈ្មោះរឿង** ដែលអ្នកចង់លុប៖",
                    reply_markup=kb,
                )
                return

            if text == BTN_PREV_PAGE:
                page = max(0, page - 1)
                kb, cur_page, total_pages = drama_pagination_keyboard(dramas, page, 10)
                state["page"] = cur_page
                send_clean_message(
                    message,
                    f"📄 ទំព័រទី {cur_page + 1} / {total_pages} (សរុប {len(dramas)} រឿង)\n"
                    "👇 សូមចុចជ្រើសរើស **ឈ្មោះរឿង** ដែលអ្នកចង់លុប៖",
                    reply_markup=kb,
                )
                return

            drama_title = resolve_drama_title_or_code(text)
            if not drama_title:
                kb, cur_page, _ = drama_pagination_keyboard(dramas, page, 10)
                send_clean_message(message, "❌ សូមចុចជ្រើសរើសឈ្មោះរឿងពីប៊ូតុងខាងក្រោម៖", reply_markup=kb)
                return

            state["drama_title"] = drama_title

            if state.get("delete_mode") == "ALL":
                state["step"] = "DEL_ALL_CONFIRM"
                confirm_kb = ReplyKeyboardMarkup(resize_keyboard=True, row_width=2)
                confirm_kb.add(
                    KeyboardButton("✅ បាទ/ចាស លុបចោល"),
                    KeyboardButton(BTN_CANCEL),
                )
                send_clean_message(
                    message,
                    f"⚠️ តើអ្នកពិតជាចង់លុបរឿង «{drama_title}» ({ensure_drama_code(drama_title)}) ទាំងមូលមែនទេ?\n"
                    "(វីដេអូគ្រប់ភាគ, រូប Album, GIF និង Cover នឹងត្រូវលុបចេញពី Database និង Channel ទាំងអស់)",
                    reply_markup=confirm_kb,
                )
            else:
                state["step"] = "DEL_EP_WAIT_NUM"
                send_clean_message(
                    message,
                    f"🎬 រឿង៖ {drama_title} ({ensure_drama_code(drama_title)})\n\n🔢 សូមវាយបញ្ចូល **លេខភាគ** ដែលអ្នកចង់លុប (ជាលេខគត់)៖",
                    reply_markup=cancel_keyboard(),
                )
            return

        if step == "DEL_ALL_CONFIRM":
            if text == "✅ បាទ/ចាស លុបចោល":
                _, msg = delete_entire_drama_in_db(state["drama_title"])
                admin_states.pop(user_id, None)
                send_clean_message(message, msg, reply_markup=main_menu_keyboard())
            else:
                admin_states.pop(user_id, None)
                send_clean_message(message, "បានបោះបង់ការលុប។", reply_markup=main_menu_keyboard())
            return

        if step == "DEL_EP_WAIT_NUM":
            if not text.isdigit() or int(text) < 1:
                send_clean_message(message, "❌ សូមបញ្ចូលលេខភាគជា លេខគត់៖", reply_markup=cancel_keyboard())
                return

            ep_num = int(text)
            _, msg = delete_single_episode_in_db(state["drama_title"], ep_num)
            admin_states.pop(user_id, None)
            send_clean_message(message, msg, reply_markup=main_menu_keyboard())
            return

        # =================================================
        # FLOW 5: ពិនិត្យភាគរឿង (CHECK DRAMA BY TITLE OR CODE)
        # =================================================
        if step == "CHECK_WAIT_TITLE":
            drama_title = resolve_drama_title_or_code(text)
            if not drama_title:
                send_clean_message(message, "❌ សូមវាយបញ្ចូលចំណងជើងរឿង ឬ CODE៖", reply_markup=cancel_keyboard())
                return

            admin_states.pop(user_id, None)
            send_drama_episode_list(message, drama_title, reply_markup=main_menu_keyboard())
            return

    except Exception:
        log.exception("Interactive workflow error")
        send_clean_message(
            message,
            "❌ មានបញ្ហាបច្ចេកទេសកើតឡើង។ សូមពិនិត្យ Render Logs ឬចុច «❌ បោះបង់» ដើម្បីចាប់ផ្ដើមឡើងវិញ។",
            reply_markup=cancel_keyboard(),
        )


