                if cached_user_bot_photo_id:
                    try:
                        user_bot_client.send_photo(
                            chat_id=uid,
                            photo=cached_user_bot_photo_id,
                            caption=caption_text,
                            parse_mode="HTML",
                            reply_markup=markup,
                        )
                        delivered = True
                    except Exception:
                        delivered = False

                if not delivered and cover_bytes:
