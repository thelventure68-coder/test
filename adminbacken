                            text=caption_text,
                            parse_mode="HTML",
                            reply_markup=markup,
                        )
                        delivered = True
                    except Exception:
                        delivered = False

                if delivered:
                    sent_ok += 1
                else:
                    failed_count += 1

                time.sleep(0.05)

            save_notification_stats_to_db(drama_title, sent_ok, failed_count)

