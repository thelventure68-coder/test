@asynccontextmanager
async def lifespan(app: FastAPI):
    load_admins_from_db()
    sync_all_existing_drama_codes()
    ensure_webhook_active(force=True)
    log.info("XFANSTER Admin Bot webhook configured & drama codes synced at startup.")
    yield
    log.info("Shutting down instance — keeping webhook active.")


app = FastAPI(
    title="XFANSTER Admin Bot",
    version="5.0.0",
    lifespan=lifespan,
)


@app.api_route("/", methods=["GET", "HEAD"])
def home(background_tasks: BackgroundTasks):
    background_tasks.add_task(ensure_webhook_active, False)
    return {
        "service": "XFANSTER Admin Bot",
        "status": "running",
    }


@app.api_route("/health", methods=["GET", "HEAD"])
def health(background_tasks: BackgroundTasks):
    background_tasks.add_task(ensure_webhook_active, False)
    return {"status": "ok"}


@app.get("/reset-webhook")
def reset_webhook():
    ensure_webhook_active(force=True)
    info = bot.get_webhook_info()
    return {
        "ok": True,
        "webhook_url": info.url,
        "pending_update_count": info.pending_update_count,
        "last_error_message": info.last_error_message,
    }


def process_telegram_update(payload: dict):
    try:
        update = telebot.types.Update.de_json(payload)
        bot.process_new_updates([update])
    except Exception:
        log.exception("Background update processing failed")


@app.post(WEBHOOK_PATH)
async def telegram_webhook(request: Request, background_tasks: BackgroundTasks):
    supplied_secret = request.headers.get(
        "X-Telegram-Bot-Api-Secret-Token", ""
    )

    if WEBHOOK_SECRET and not secrets.compare_digest(supplied_secret, WEBHOOK_SECRET):
        raise HTTPException(status_code=403, detail="Invalid webhook secret")

    try:
        payload = await request.json()
        background_tasks.add_task(process_telegram_update, payload)
        return JSONResponse({"ok": True})
    except HTTPException:
        raise
    except Exception:
        log.exception("Webhook request parsing failed")
        raise HTTPException(status_code=500, detail="Update processing failed")
