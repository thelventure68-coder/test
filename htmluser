      padding: 10px 12px;
      color: #e5e5e5;
      font-size: 12px;
      line-height: 1.55;
      margin: 0 0 18px 0;
    }

    .detail-synopsis-notice svg {
      width: 15px;
      height: 15px;
      stroke: #d4d4d4;
      stroke-width: 2;
      fill: none;
      flex-shrink: 0;
      margin-top: 2px;
    }

    .detail-synopsis-notice strong {
      color: #d4d4d4;
      font-weight: 700;
    }

    /* Album Section (3 Photos) */
    .album-section {
      margin-bottom: 20px;
      background: #050505;
      border: 1px solid #222222;
      border-radius: 15px;
      padding: 12px;
    }

    .album-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }

    .album-card {
      position: relative;
      width: 100%;
      aspect-ratio: 3 / 4;
      border-radius: 10px;
      background: #121212;
      border: 1px solid #262626;
      overflow: hidden;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform .14s ease, border-color .15s ease;
    }

    .album-card:hover { border-color: #3f3f3f; }
    .album-card:active { transform: scale(0.97); }

    .album-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .album-card img.loaded { opacity: 1; }

    /* Episode Cover Cards */
    .ep-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 8px;
      margin-bottom: 20px;
    }

    .ep-card-wrap {
      position: relative;
      min-width: 0;
    }

    .ep-card {
      width: 100%;
      padding: 0;
      border: 1px solid #242424;
      background: #0d0d0d;
      color: var(--text);
      border-radius: 10px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      text-align: center;
      transition: transform .12s ease, border-color .15s ease, background .15s ease;
    }

    .ep-card:hover {
      background: #151515;
      border-color: #383838;
    }

    .ep-card:active { transform: scale(0.96); }

    .ep-card.current {
      border-color: #a3a3a3;
      box-shadow: 0 0 0 1px rgba(163, 163, 163, 0.35);
    }

    .ep-card:disabled {
      opacity: 0.55;
      cursor: wait;
    }

    .ep-thumb-wrap {
      position: relative;
      width: 100%;
      aspect-ratio: 3 / 4;
      background: #141414;
      overflow: hidden;
    }

    .ep-thumb {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      opacity: 0;
      transition: opacity 0.32s ease;
    }

    .ep-thumb.loaded { opacity: 1; }

    .ep-play-mini {
      position: absolute;
      inset: 0;
      margin: auto;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.52);
      border: 1px solid rgba(255, 255, 255, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      z-index: 3;
    }

    .ep-play-mini svg {
      width: 11px;
      height: 11px;
      stroke: #ffffff;
      stroke-width: 2;
      fill: #ffffff;
      margin-left: 1px;
    }

    .ep-num-bar {
      padding: 5.5px 4px;
      background: #0a0a0a;
      border-top: 1px solid #1c1c1c;
      font-size: 11px;
      font-weight: 700;
      color: #f2f2f2;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .ep-card.current .ep-num-bar {
      background: rgba(163, 163, 163, 0.16);
      color: #e5e5e5;
    }

    .latest-dot {
      display: inline-block;
      width: 5.5px;
      height: 5.5px;
      border-radius: 50%;
      background: #a3a3a3;
      box-shadow: 0 0 6px rgba(163, 163, 163, 0.9);
      animation: latestBlink 1.2s ease-in-out infinite;
    }

    @keyframes latestBlink {
      0%, 100% { opacity: 1; }
      50% { opacity: .25; }
    }

    /* Vote Star + Admin Request Card */
    .notice-feedback-card {
      margin-top: 18px;
      background: #040404;
      border: 1px solid #242424;
      border-radius: 15px;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 13px;
    }

    .vote-star-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
      padding: 4px 2px 12px;
      border-bottom: 1px solid #1b1b1b;
    }

    .vote-label-wrap {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .vote-title {
      font-size: 13px;
      font-weight: 600;
      color: #ffffff;
    }

    .vote-meta {
      font-size: 11.5px;
      color: var(--muted);
    }

    .star-group {
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .star-btn {
      width: 34px;
      height: 34px;
      border-radius: 9px;
      border: 1px solid #242424;
      background: #121212;
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: transform .14s ease, border-color .15s ease, background .15s ease;
    }

    .star-btn:active { transform: scale(0.86); }

    .star-btn svg {
      width: 19px;
      height: 19px;
      stroke: #525252;
      stroke-width: 1.85;
      fill: transparent;
      transition: stroke .18s ease, fill .18s ease;
    }

    .star-btn.active {
      border-color: rgba(212, 212, 212, 0.45);
      background: rgba(212, 212, 212, 0.08);
    }

    .star-btn.active svg {
      stroke: var(--gold);
      fill: var(--gold);
      filter: drop-shadow(0 0 5px rgba(212, 212, 212, 0.35));
    }

    .request-box {
      display: flex;
      flex-direction: column;
      gap: 9px;
    }

    .request-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      flex-wrap: wrap;
    }

    .request-title {
      font-size: 13px;
      font-weight: 600;
      color: #ffffff;
    }

    .admin-group-link {
      font-size: 11.5px;
      color: #d4d4d4;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 8px;
      border-radius: 99px;
      background: rgba(212, 212, 212, 0.12);
      border: 1px solid rgba(212, 212, 212, 0.28);
