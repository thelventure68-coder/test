  // ============================================================================
  // SORTING BY NEWEST FIRST & METADATA EXTRACTORS
  // ============================================================================

  function parseDDMMYYYYToTimestamp(dateStr) {
    if (!dateStr) return 0;
    const m = String(dateStr).trim().match(/^(\d{2})-(\d{2})-(\d{4})$/);
    if (m) {
      return Date.UTC(Number(m[3]), Number(m[2]) - 1, Number(m[1]));
    }
    const parsed = Date.parse(String(dateStr));
    return Number.isFinite(parsed) ? parsed : 0;
  }

  function sortNewestDramasFirst(items) {
    if (!Array.isArray(items)) return [];
    return [...items].sort((a, b) => {
      const idDiff = (Number(b?.latest_id) || 0) - (Number(a?.latest_id) || 0);
      if (idDiff !== 0) return idDiff;
      return parseDDMMYYYYToTimestamp(b?.upload_date) - parseDDMMYYYYToTimestamp(a?.upload_date);
    });
  }

  function getTitle(item) {
    return String(item?.title || item?.drama_title || item?.name || "Untitled");
  }

  function getDramaCode(item) {
    return String(item?.drama_code || item?.code || "").trim().toUpperCase();
  }

  function getUploadDate(item) {
    return String(item?.upload_date || "").trim();
  }

  function getDurationText(item) {
    if (item?.duration_text) return String(item.duration_text).trim();
    const sec = Number(item?.duration_seconds || 0);
    if (sec > 0) {
      const h = Math.floor(sec / 3600);
      const m = Math.floor((sec % 3600) / 60);
      const s = sec % 60;
      if (h > 0) return `${h}:${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`;
      return `${m}:${String(s).padStart(2, "0")}`;
    }
    return "";
  }

  function getSynopsis(item) {
    return String(item?.synopsis || item?.description || "").trim();
  }

  function getTags(item) {
    return String(item?.tags || "").trim();
  }

  function getCoverVersion(item) {
    return String(item?.cover_version || "v1");
  }

  function getGifUrl(item) {
    const titleText = getTitle(item);
    const ver = String(item?.gif_version || "v1");
    return `${API_BASE}/api/gif/${encodeURIComponent(titleText)}?v=${encodeURIComponent(ver)}`;
  }

  function getCover(item) {
    const ver = getCoverVersion(item);
    if (item?.cover_url || item?.cover || item?.coverUrl) {
      const rawUrl = String(item.cover_url || item.cover || item.coverUrl);
      const sep = rawUrl.includes("?") ? "&" : "?";
      return `${rawUrl}${sep}v=${encodeURIComponent(ver)}`;
    }
    const titleText = getTitle(item);
    return `${API_BASE}/api/cover/${encodeURIComponent(titleText)}?v=${encodeURIComponent(ver)}`;
  }

  // ប្រសិនបើភាគនោះមាន Custom Cover ទើបហៅទៅ /api/ep-cover បើគ្មានទេប្រើរូប Cover រឿងធំដែលមានក្នុង Cache ស្រាប់
  function getEpisodeCoverUrl(titleText, epObj, fallbackDramaCoverUrl = "") {
    const epNum = Number(epObj?.ep_number || 1);
    const ver = String(epObj?.cover_version || `ep_${epNum}`);
    if (epObj?.has_custom_cover) {
      return `${API_BASE}/api/ep-cover/${encodeURIComponent(titleText)}/${encodeURIComponent(epNum)}?v=${encodeURIComponent(ver)}`;
    }
    if (epObj?.cover_url && String(epObj.cover_url).startsWith("http")) {
      const rawUrl = String(epObj.cover_url);
      const sep = rawUrl.includes("?") ? "&" : "?";
      return `${rawUrl}${sep}v=${encodeURIComponent(ver)}`;
    }
    return fallbackDramaCoverUrl || `${API_BASE}/api/cover/${encodeURIComponent(titleText)}?v=${encodeURIComponent(ver)}`;
  }

  function getAlbumPhotoUrl(titleText, slot, version = "v1") {
    return `${API_BASE}/api/album/${encodeURIComponent(titleText)}/${encodeURIComponent(slot)}?v=${encodeURIComponent(version)}`;
  }

  function getRawViews(item) {
    const raw = item?.views ?? item?.view_count ?? item?.views_count ?? 0;
    const num = Number(raw);
    return Number.isFinite(num) && num >= 0 ? num : 0;
  }

  function getViewsCount(item) {
    const num = getRawViews(item);
    if (num >= 1000000) return (num / 1000000).toFixed(1).replace(/\.0$/, "") + "M";
    if (num >= 1000) return (num / 1000).toFixed(1).replace(/\.0$/, "") + "K";
    return String(Math.floor(num));
  }

  function normalizeCategory(cat) {
    if (!cat) return "";
    let c = String(cat).trim();
    ["🇨🇳 ", "🇰🇭 ", "🤖 ", "🇰🇷 ", "✨ ", "🇨🇳", "🇰🇭", "🤖", "🇰🇷", "✨"].forEach(p => {
      c = c.replace(p, "");
    });
    c = c.trim();
    if (c === "រឿងភាគចិន") return "រឿងចិន";
    if (c === "រឿងភាគខ្មែរ") return "រឿងខ្មែរ";
    if (c === "រឿងភាគកូរ៉េ") return "រឿងកូរ៉េ";
    return c;
  }

