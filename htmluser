  function buildCategoryPills() {
    const knownKeys = new Set(defaultCategories.map(c => c.key));
    const dynamicCategories = [...defaultCategories];

    serverCategories.forEach(rawCat => {
      const cat = normalizeCategory(rawCat);
      if (cat && !knownKeys.has(cat)) {
        knownKeys.add(cat);
        dynamicCategories.push({ key: cat, label: cat });
      }
    });

    const sourceForCats = newestCatalogDramas.length > 0 ? newestCatalogDramas : allDramas;
    sourceForCats.forEach(d => {
      const cat = normalizeCategory(d.category);
      if (cat && !knownKeys.has(cat)) {
        knownKeys.add(cat);
        dynamicCategories.push({ key: cat, label: cat });
      }
    });

    if (currentCategory !== "all" && !knownKeys.has(currentCategory)) {
      currentCategory = "all";
    }

    if (viewMode === "home") {
      sectionTitle.textContent = currentCategory === "all" ? "រឿងទាំងអស់" : currentCategory;
    }

    categoryFilter.replaceChildren();
    dynamicCategories.forEach(catObj => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "cat-pill" + (viewMode === "home" && currentCategory === catObj.key ? " active" : "");
      btn.dataset.cat = catObj.key;
      btn.setAttribute("aria-pressed", viewMode === "home" && currentCategory === catObj.key ? "true" : "false");
      btn.textContent = catObj.label;

      btn.onclick = () => {
        currentCategory = catObj.key;
        categoryFilter.querySelectorAll("button[data-cat]").forEach(p => {
          const active = p === btn;
          p.classList.toggle("active", active);
          p.setAttribute("aria-pressed", active ? "true" : "false");
        });
        showListView(false);
        page = 1;
        sectionTitle.textContent = currentCategory === "all" ? "រឿងទាំងអស់" : catObj.label;
        savePersistedState({ page: 1, currentCategory, viewMode: "home", activeDetailDramaTitle: null });

        if (viewMode !== "home") {
          viewMode = "home";
          document.querySelectorAll('.side-btn').forEach(b => b.classList.remove('active'));
          document.getElementById("home-btn").classList.add('active');
          loadDramas(true);
        } else {
          if (currentCategory === "all" && newestCatalogDramas.length > 0) {
            allDramas = [...newestCatalogDramas];
          }
          render();
        }
      };

      categoryFilter.appendChild(btn);
    });
  }

