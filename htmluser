      background: #111111;
      color: var(--text);
      border: 1px solid #262626;
      border-radius: 11px;
      padding: 10px 12px;
      font-size: 13px;
      line-height: 1.5;
      outline: none;
      transition: border-color .15s, opacity .15s;
    }

    .request-input:focus { border-color: #4d4d4d; }
    .request-input::placeholder { color: #737373; }
    .request-input:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      background: #0d0d0d;
    }

    .request-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .request-status {
      font-size: 12px;
      color: var(--muted);
      min-height: 18px;
      line-height: 1.45;
    }

    .request-send-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      background: #1e1e1e;
      color: #ffffff;
      border: 1px solid #3a3a3a;
      border-radius: 10px;
      padding: 8px 15px;
      font-size: 12.5px;
      font-weight: 600;
      white-space: nowrap;
      flex-shrink: 0;
      transition: background .15s, transform .12s, opacity .15s;
    }

    .request-send-btn:hover { background: #292929; }
    .request-send-btn:active { transform: scale(0.96); }
    .request-send-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    /* Admin-Only Analytics Modal & Lightbox Modal */
    .admin-modal-backdrop,
    .lightbox-backdrop {
      position: fixed;
      inset: 0;
      z-index: 9000;
      background: rgba(0, 0, 0, 0.86);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }

    .lightbox-img {
      max-width: 94vw;
      max-height: 86vh;
      border-radius: 14px;
      border: 1px solid #333333;
      object-fit: contain;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9);
    }

    .admin-modal {
      width: 100%;
      max-width: 440px;
      background: #101010;
      border: 1px solid #2b2b2b;
      border-radius: 18px;
      padding: 18px;
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.85);
    }

    .admin-modal-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
      padding-bottom: 10px;
      border-bottom: 1px solid #222222;
    }

    .admin-modal-head h3 {
      margin: 0;
      font-size: 15px;
      font-weight: 700;
      color: #ffffff;
      display: flex;
      align-items: center;
      gap: 7px;
    }

    .admin-close-btn {
      width: 30px;
      height: 30px;
      border-radius: 8px;
      border: 1px solid #2a2a2a;
      background: #181818;
      color: #cccccc;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 9px;
      margin-bottom: 14px;
    }

    .stat-card {
      background: #161616;
      border: 1px solid #252525;
      border-radius: 12px;
      padding: 10px 12px;
    }

    .stat-label {
      color: var(--muted);
      font-size: 11px;
      margin-bottom: 4px;
    }

    .stat-val {
      color: #ffffff;
      font-size: 17px;
      font-weight: 700;
    }

    .notif-stat-box {
      background: #141414;
      border: 1px solid #252525;
      border-radius: 12px;
      padding: 12px;
      font-size: 12px;
      line-height: 1.65;
      color: #d4d4d4;
    }

    .copy-toast {
      position: fixed;
      top: 18px;
      left: 50%;
      transform: translateX(-50%) translateY(-20px);
      background: rgba(20, 20, 20, 0.96);
      border: 1px solid #383838;
      color: #ffffff;
      padding: 8px 16px;
      border-radius: 999px;
      font-size: 12.5px;
      font-weight: 600;
      z-index: 9999;
      opacity: 0;
      pointer-events: none;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.65);
