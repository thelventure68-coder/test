  async function playEpisodeInBot(titleText, epNumber, clickedButton, isRetryAfterModal = false) {
    savePersistedState();
    const tg = window.Telegram?.WebApp;
    const userId = getUserId();
    if (userId) {
      const originalHTML = clickedButton ? clickedButton.innerHTML : "";
      try {
        if (clickedButton && !isRetryAfterModal) {
          clickedButton.disabled = true;
        }
        const res = await fetch(`${API_BASE}/api/select-drama`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ user_id: userId, title: titleText, ep_number: epNumber })
        });
        if (res.status === 403) {
          const data = await res.json().catch(() => ({}));
          if (data.status === "join_required") {
            if (clickedButton) {
              clickedButton.innerHTML = originalHTML;
              clickedButton.disabled = false;
            }
            showChannelJoinModal(
              data.channel_link || "https://t.me/xfanster",
              titleText,
              epNumber,
              clickedButton,
              Boolean(isRetryAfterModal)
            );
            return;
          }
        }
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const existingModal = document.getElementById("xfansterChannelJoinModal");
        if (existingModal) existingModal.remove();
        tg?.close();
      } catch (error) {
        console.error("Play episode failed:", error);
        if (clickedButton) {
          clickedButton.innerHTML = originalHTML;
          clickedButton.disabled = false;
        }
        alert("មិនអាចបើកភាគនេះបានទេ សូមព្យាយាមម្ដងទៀត។");
      }
    } else if (tg) {
      try {
        tg.sendData(JSON.stringify({ action: "select_drama", title: titleText, ep_number: epNumber }));
      } catch (error) {
        alert("សូមបើក Mini App នេះពីក្នុង Telegram Bot ផ្ទាល់។");
      }
    } else {
      alert("សូមបើក Mini App នេះពី Telegram Bot ដើម្បីជ្រើសរើសភាគ។");
