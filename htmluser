    albumSection.classList.remove("hidden");
    albumCountLabel.textContent = `${validAlbums.length} រូប`;
    albumContainer.replaceChildren();

    validAlbums.sort((a, b) => Number(a.slot) - Number(b.slot)).forEach(slotInfo => {
