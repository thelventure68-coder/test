    if (!pending || document.visibilityState === "hidden") return;
    if (pending.clickedAt && (Date.now() - pending.clickedAt) < 500) return;
    window.__xfansterPendingJoinRetry = null;
    playEpisodeInBot(pending.titleText, pending.epNumber, pending.clickedButton, true);
