  function renderDramaAlbumSection(titleText, albumList) {
    if (!albumSection || !albumContainer) return;
    const validAlbums = Array.isArray(albumList)
      ? albumList.filter(item => Number(item?.slot || 0) >= 1 && Number(item?.slot || 0) <= 3)
      : [];

    if (validAlbums.length === 0) {
      albumSection.classList.add("hidden");
      albumContainer.replaceChildren();
      return;
