  function renderFeaturedSliders() {
    const query = search.value.trim();
    const sourceCatalog = newestCatalogDramas.length > 0 ? newestCatalogDramas : allDramas;

    const shouldShowSliders = (
      viewMode === "home" &&
      currentCategory === "all" &&
      !query &&
      page === 1 &&
      sourceCatalog.length > 0
    );

    if (!shouldShowSliders) {
      topTrendingBlock?.classList.add("hidden");
      popularBlock.classList.add("hidden");
      return;
    }


    if (topTrendingDramas && topTrendingDramas.length > 0) {
      populateInfiniteTrack(topTrendingTrack, topTrendingDramas);
      topTrendingCount.textContent = `${topTrendingDramas.length} រឿង`;
      topTrendingBlock.classList.remove("hidden");
      enableDraggableAndAutoSlide(topTrendingTrack, 3400, false);
    } else {
      topTrendingBlock.classList.add("hidden");
    }

    const popularDramas = [...sourceCatalog]
      .sort((a, b) => getRawViews(b) - getRawViews(a))
      .slice(0, SLIDER_MAX_ITEMS);

    populateInfiniteTrack(popularTrack, popularDramas);
    popularCount.textContent = `ពេញនិយម ${popularDramas.length} រឿង`;
    popularBlock.classList.remove("hidden");
    enableDraggableAndAutoSlide(popularTrack, 3600, false);
  }

  async function renderRecommendedSliders(currentDrama) {
    const currentTitle = getTitle(currentDrama);
    const currentCat = normalizeCategory(currentDrama.category);

    let sourceList = newestCatalogDramas.length > 0 ? newestCatalogDramas : allDramas;

    if (sourceList.length <= 1) {
      try {
        const res = await fetch(`${API_URL}?_t=${Date.now()}`, { cache: "no-store" });
        if (res.ok) {
          const d = await res.json();
          const fetched = Array.isArray(d.items) ? d.items : [];
          if (fetched.length > 0) {
            newestCatalogDramas = sortNewestDramasFirst(fetched);
            sourceList = newestCatalogDramas;
          }
        }
      } catch (_) {}
    }

    const sameCatDramas = sourceList.filter(d => {
      const t = getTitle(d);
      if (t === currentTitle) return false;
      return currentCat && normalizeCategory(d.category) === currentCat;
    });

    let recommendedList = [...sameCatDramas];
    if (recommendedList.length < SLIDER_MAX_ITEMS) {
      const otherDramas = sourceList.filter(d => {
        const t = getTitle(d);
        return t !== currentTitle && !recommendedList.some(r => getTitle(r) === t);
      });
      recommendedList = [...recommendedList, ...otherDramas];
    }

    recommendedList = recommendedList.slice(0, SLIDER_MAX_ITEMS);

    if (!recommendedList.length) {
      recommendedBlock.classList.add("hidden");
      return;
    }

    populateInfiniteTrack(recommendedTrack, recommendedList);
    recommendedSub.textContent = (sameCatDramas.length > 0 && currentCat)
      ? `${currentCat} • ${recommendedList.length} រឿង`
      : `${recommendedList.length} រឿង`;

    recommendedBlock.classList.remove("hidden");
    enableDraggableAndAutoSlide(recommendedTrack, 3300, true);
  }

