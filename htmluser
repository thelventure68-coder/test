  const SMART_SYNONYM_GROUPS = [
    ["ខ្មែរ", "រឿងខ្មែរ", "រឿងសិចខ្មែរ", "សិចខ្មែរ", "khmer", "cambodia", "cambo"],
    ["ចិន", "រឿងចិន", "រឿងសិចចិន", "chinese", "china"],
    ["កូរ៉េ", "រឿងកូរ៉េ", "រឿងសិចកូរ៉េ", "korean", "korea"],
    ["ជប៉ុន", "រឿងជប៉ុន", "រឿងសិចជប៉ុន", "japanese", "japan", "jav"],
    ["ថៃ", "រឿងថៃ", "រឿងសិចថៃ", "thai", "thailand"],
    ["អឺរ៉ុប", "បរទេស", "អាមេរិក", "western", "english", "usa"],
    ["ស្នេហា", "រ៉ូមែនទិក", "សិចស៊ី", "រឿងសិច", "romance", "romantic", "sexy", "love"],
    ["វាយតប់", "សកម្មភាព", "action"],
    ["ai", "រឿងai", "រឿង ai"]
  ];

  function matchesSmartSearch(drama, rawQuery, recentTopTitlesSet) {
    const q = String(rawQuery || "").trim().toLocaleLowerCase();
    if (!q) return true;

    if (["រឿងថ្មី", "រឿងមកដល់ថ្មី", "ថ្មី", "new", "latest"].includes(q)) {
      return recentTopTitlesSet.has(getTitle(drama));
    }

    const title = getTitle(drama).toLocaleLowerCase();
    const code = getDramaCode(drama).toLocaleLowerCase();
    const cat = normalizeCategory(drama.category).toLocaleLowerCase();
    const syn = getSynopsis(drama).toLocaleLowerCase();
    const tags = getTags(drama).toLocaleLowerCase();
    const serverTokens = String(drama?.search_tokens || "").toLocaleLowerCase();
    const uploadDate = getUploadDate(drama).toLocaleLowerCase();

    const searchableBlob = `${title} ${code} ${code.replace("-", "")} ${cat} ${syn} ${tags} ${serverTokens} ${uploadDate}`;

    if (code) {
      const cleanQ = q.replace(/\s+/g, "");
      const codeNoDash = code.replace("-", "");
      const codeNumPart = code.replace("xf-", "");
      if (
        code.includes(cleanQ) ||
        codeNoDash.includes(cleanQ) ||
        (cleanQ.match(/^\d+$/) && (codeNumPart === cleanQ.padStart(6, "0") || codeNumPart.endsWith(cleanQ)))
      ) {
        return true;
      }
    }

    if (searchableBlob.includes(q)) return true;

    const queryWords = q.split(/\s+/).filter(Boolean);
    return queryWords.every(word => {
      if (["រឿង", "រឿងសិច", "សិច", "movie", "drama", "video"].includes(word) && queryWords.length > 1) {
        return true;
      }
      if (searchableBlob.includes(word)) return true;
      for (const group of SMART_SYNONYM_GROUPS) {
        if (group.includes(word)) {
          return group.some(synWord => searchableBlob.includes(synWord));
        }
      }
      return false;
    });
  }

