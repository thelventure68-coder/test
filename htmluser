    favBtn.onclick = () => toggleDramaFavorite(titleText);

    if (adminTrendingBtn) {
      adminTrendingBtn.classList.add("hidden");
    }

    const localStars = getLocalDramaRating(titleText);
    updateStarUI(localStars);

    applyDailyRequestLimitUI(hasSentRequestTodayLocal());

    detailCover.onload = () => {
      detailCover.classList.add("loaded");
      detailSpinner.style.display = "none";
    };
    detailCover.onerror = () => {
      detailCover.onerror = null;
      detailCover.src = placeholder;
      detailCover.classList.add("loaded");
      detailSpinner.style.display = "none";
    };

    loadCoverWithCache(coverUrl).then(resolvedUrl => {
      if (requestSeq !== activeDetailRequestSeq) return;
      if (detailGifVideo.classList.contains("hidden")) {
        detailCover.src = resolvedUrl || placeholder;
        if (detailCover.complete && detailCover.naturalWidth > 0) {
          detailCover.classList.add("loaded");
          detailSpinner.style.display = "none";
        }
      }
    });

    detailSub.textContent = "កំពុងផ្ទុកភាគ...";
    epCount.textContent = "";
    continueBtn.innerHTML = `<span class="btn-mini-spinner"></span><span>កំពុងផ្ទុក...</span>`;
    continueBtn.classList.remove("hidden");
    continueBtn.disabled = true;
    continueBtn.onclick = null;

    albumSection.classList.add("hidden");
    albumContainer.replaceChildren();
    episodesSection.classList.add("hidden");
    episodesContainer.replaceChildren();

    renderRecommendedSliders(drama);

    try {
      const userId = getUserId();
      const queryParam = userId ? `?user_id=${encodeURIComponent(userId)}&_t=${Date.now()}` : `?_t=${Date.now()}`;
      const url = `${API_BASE}/api/dramas/${encodeURIComponent(titleText)}/episodes${queryParam}`;

      const res = await fetch(url, {
        method: "GET",
        headers: { "Accept": "application/json" },
        cache: "no-store"
      });

      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const data = await res.json();
      if (requestSeq !== activeDetailRequestSeq) return;

      if (data.is_admin === true) {
        isAdminUser = true;
        adminStatsBtn?.classList.remove("hidden");
      }

      const episodes = Array.isArray(data.episodes) ? data.episodes : [];
      const lastEp = data.last_ep ? Number(data.last_ep) : null;

      const resolvedCode = String(data.drama_code || initialCode || "").trim().toUpperCase();
      const resolvedDate = String(data.upload_date || initialDate || "").trim();
      const resolvedDuration = String(data.duration_text || initialDuration || "").trim();
      updateDetailCodeAndDateBadges(resolvedCode, resolvedDate, initialCat, resolvedDuration);

      if (data.has_gif || drama.has_gif) {
        tryActivateDetailGifPreview({ ...drama, has_gif: true, gif_version: data.gif_version || drama.gif_version }, requestSeq);
      }

      const resolvedViews = (data.views !== undefined && data.views !== null)
        ? Math.max(initialViews, Number(data.views) || 0)
        : initialViews;
      updateDetailViewsUI(resolvedViews);

      const mergedFav = Boolean(data.is_favorite) || isDramaFavoritedLocally(titleText);
      const resolvedLikes = Math.max(
        Number(data.likes_count || 0),
        mergedFav ? 1 : 0
      );
      favBtn.dataset.likesCount = String(resolvedLikes);
      updateDetailLikeButtonUI(mergedFav, resolvedLikes);
      if (data.is_favorite) setLocalFavoriteState(titleText, true);

      if (data.can_request_today === false) {
        markRequestSentTodayLocal(data.cambodia_date || "");
        applyDailyRequestLimitUI(true);
      } else {
        applyDailyRequestLimitUI(hasSentRequestTodayLocal());
      }

      const serverUserRating = Number(data.user_rating || localStars || 0);
      if (serverUserRating > 0) setLocalDramaRating(titleText, serverUserRating);
      updateStarUI(serverUserRating, Number(data.avg_rating || 0), Number(data.rating_count || 0));

      renderDramaAlbumSection(titleText, data.album || []);

      episodesContainer.replaceChildren();

      if (!episodes.length) {
        detailSub.textContent = "មិនទាន់មានភាគទេ";
        continueBtn.innerHTML = `<span>មិនទាន់មានភាគ</span>`;
        continueBtn.disabled = true;
        episodesSection.classList.add("hidden");
        return;
      }

      const isSingleVideoMovie = episodes.length === 1;
      const targetEp = lastEp || Number(episodes[0].ep_number) || 1;

      if (isSingleVideoMovie) {
        detailSub.textContent = "មួយភាគចប់ (Full)";
        continueBtn.innerHTML = `${PLAY_LINE_ICON}<span>មើលរឿងពេញ</span>`;
        continueBtn.disabled = false;
        continueBtn.onclick = () => playEpisodeInBot(titleText, targetEp, continueBtn);
        episodesSection.classList.add("hidden");
      } else {
        episodesSection.classList.remove("hidden");
        epCount.textContent = `${episodes.length} ភាគ`;
        detailSub.textContent = lastEp
          ? `ធ្លាប់មើលដល់ ភាគ ${lastEp} • សរុប ${episodes.length} ភាគ`
          : `សរុប ${episodes.length} ភាគ`;

        const labelText = lastEp ? `បន្តភាគ ${lastEp}` : `មើលភាគ ${targetEp}`;
        continueBtn.innerHTML = `${PLAY_LINE_ICON}<span>${labelText}</span>`;
        continueBtn.disabled = false;
        continueBtn.onclick = () => playEpisodeInBot(titleText, targetEp, continueBtn);

        episodes.forEach(epObj => {
          episodesContainer.appendChild(
            createEpisodeCoverCard(titleText, epObj, targetEp, lastEp, coverUrl)
          );
        });
      }
    } catch (error) {
      if (requestSeq !== activeDetailRequestSeq) return;
      console.error("Load episodes failed:", error);
      detailSub.textContent = "បរាជ័យក្នុងការទាញភាគ";
      continueBtn.innerHTML = `<span>មិនអាចផ្ទុកភាគ</span>`;
      continueBtn.disabled = true;
      episodesSection.classList.remove("hidden");
      episodesContainer.replaceChildren();
      const errBox = document.createElement("div");
      errBox.className = "status";
      errBox.textContent = "មិនអាចទាញយកបញ្ជីភាគបានទេ។";
      const retryBtn = document.createElement("button");
      retryBtn.className = "retry";
      retryBtn.textContent = "ព្យាយាមម្ដងទៀត";
      retryBtn.onclick = () => openDramaDetail(drama);
      errBox.appendChild(retryBtn);
      episodesContainer.appendChild(errBox);
    }
  }

  function showListView(clearDetailState = true) {
    resetDetailGifPreview();
    detailView.classList.add("hidden");
    listView.classList.remove("hidden");
    if (clearDetailState) {
      activeDetailDramaTitle = null;
      activeDetailDramaObj = null;
      savePersistedState({ activeDetailDramaTitle: null });
    }
    if (viewMode === "favorites") {
      loadFavorites(true);
    }
  }

  backBtn.addEventListener("click", () => {
    showListView(true);
  });

  function render() {
    const query = search.value.trim();
    const sourceCatalog = newestCatalogDramas.length > 0 ? newestCatalogDramas : allDramas;
    const recentTopTitlesSet = new Set(
      sourceCatalog.slice(0, Math.min(12, sourceCatalog.length)).map(d => getTitle(d))
    );

    const filtered = allDramas.filter(drama => {
      const matchSearch = matchesSmartSearch(drama, query, recentTopTitlesSet);
      const itemCat = normalizeCategory(drama.category);
      const matchCat = viewMode !== "home" || currentCategory === "all" || itemCat === currentCategory;
      return matchSearch && matchCat;
    });

    const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
    page = Math.max(1, Math.min(page, totalPages));
    savePersistedState({ page });

    renderFeaturedSliders();

    const visible = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
    container.replaceChildren();

    if (!visible.length) {
      const emptyMsg = query
        ? "រកមិនឃើញរឿងដែលត្រូវគ្នាទេ។"
        : (viewMode === "favorites" ? "មិនទាន់មានរឿងក្នុងបញ្ជីចូលចិត្តទេ។" : "មិនទាន់មានរឿងក្នុងបញ្ជីនេះទេ។");
      showStatus(emptyMsg, false);
    } else {
      visible.forEach(drama => {
        container.appendChild(createDramaCardElement(drama, false));
      });
    }

    prev.disabled = page <= 1;
    next.disabled = page >= totalPages;
    pageLabel.textContent = `ទំព័រ ${page} / ${totalPages}`;
    countLabel.textContent = `${filtered.length} រឿង`;
  }

  async function loadDramas(preservePage = true, silentRefresh = false) {
    let renderedFromInstantCache = false;

    if (!silentRefresh && newestCatalogDramas.length === 0) {
      const cachedCatalog = readCachedCatalogData();
      if (cachedCatalog && Array.isArray(cachedCatalog.items) && cachedCatalog.items.length > 0) {
        if (Array.isArray(cachedCatalog.categories)) {
          serverCategories = cachedCatalog.categories;
        }
        if (Array.isArray(cachedCatalog.top_trending)) {
          topTrendingDramas = cachedCatalog.top_trending;
        }
        newestCatalogDramas = sortNewestDramasFirst(
          cachedCatalog.items.filter(item => item && (item.title || item.drama_title || item.name))
        );
        allDramas = [...newestCatalogDramas];
        buildCategoryPills();
        if (!preservePage) page = 1;
        render();
        tryRestoreSavedDetailView();
        renderedFromInstantCache = true;
        hideAppSplash();

        if (initialSavedState?.scrollY) {
          setTimeout(() => {
            window.scrollTo({ top: Number(initialSavedState.scrollY) || 0, behavior: "instant" });
          }, 30);
        }
      }
    }

    if (!silentRefresh && !renderedFromInstantCache) {
      countLabel.textContent = "កំពុងផ្ទុក...";
      showStatus("កំពុងទាញយកបញ្ជីរឿង...", true);
    }

    try {
      const uid = getUserId();
      const queryStr = uid ? `?user_id=${encodeURIComponent(uid)}&_t=${Date.now()}` : `?_t=${Date.now()}`;
      const response = await fetch(`${API_URL}${queryStr}`, {
        method: "GET",
        headers: { "Accept": "application/json" },
        cache: "no-store"
      });
      if (!response.ok) throw new Error(`API HTTP ${response.status}`);
      const data = await response.json();

      isAdminUser = Boolean(data.is_admin);
      if (isAdminUser) {
        adminStatsBtn?.classList.remove("hidden");
      } else {
        adminStatsBtn?.classList.add("hidden");
      }

      const items = Array.isArray(data) ? data : (Array.isArray(data.items) ? data.items : (Array.isArray(data.dramas) ? data.dramas : []));

      if (Array.isArray(data.categories)) {
        serverCategories = data.categories;
      }

      if (Array.isArray(data.top_trending)) {
        topTrendingDramas = data.top_trending;
      } else {
        topTrendingDramas = [];
      }

      newestCatalogDramas = sortNewestDramasFirst(
        items.filter(item => item && (item.title || item.drama_title || item.name))
      );
      writeCachedCatalogData(newestCatalogDramas, serverCategories, topTrendingDramas);

      if (!silentRefresh || allDramas.length === 0) {
        allDramas = [...newestCatalogDramas];
      } else {
        const byTitle = new Map(newestCatalogDramas.map(d => [getTitle(d), d]));
        const updatedExisting = allDramas
          .map(d => byTitle.get(getTitle(d)))
          .filter(Boolean);
        const existingSet = new Set(updatedExisting.map(d => getTitle(d)));
        const newlyAdded = newestCatalogDramas.filter(d => !existingSet.has(getTitle(d)));
        allDramas = sortNewestDramasFirst([...newlyAdded, ...updatedExisting]);
      }

      syncDramaCoverCacheManifest(newestCatalogDramas).catch(() => {});

      buildCategoryPills();
      if (!preservePage && !renderedFromInstantCache) page = 1;
      render();
      tryRestoreSavedDetailView();

      if (!silentRefresh && !renderedFromInstantCache && initialSavedState?.scrollY) {
        setTimeout(() => {
          window.scrollTo({ top: Number(initialSavedState.scrollY) || 0, behavior: "instant" });
        }, 60);
      }
    } catch (error) {
      console.error("Failed to load dramas:", error);
      if (!silentRefresh && !renderedFromInstantCache) {
        countLabel.textContent = "មិនអាចផ្ទុកបាន";
        showStatus("មិនអាចទាញបញ្ជីរឿងបានទេ។ សូមពិនិត្យការភ្ជាប់ API រួចសាកម្ដងទៀត។", false, () => loadDramas(true, false));
        pageLabel.textContent = "Error";
        prev.disabled = true;
        next.disabled = true;
      }
    } finally {
      hideAppSplash();
    }
  }

  async function loadHistory(preservePage = true) {
    const userId = getUserId();
    if (!userId) {
      countLabel.textContent = "Error";
      showStatus("សូមបើក Mini App ពីក្នុង Telegram Bot ដើម្បីអាចមើលប្រវត្តិរឿងបាន។", false);
      hideAppSplash();
      return;
    }

    countLabel.textContent = "កំពុងផ្ទុក...";
    showStatus("កំពុងទាញយកប្រវត្តិរឿង...", true);
    sectionTitle.textContent = "រឿងធ្លាប់មើល";

    try {
      const response = await fetch(`${API_BASE}/api/history/${userId}?_t=${Date.now()}`, {
        method: "GET",
        headers: { "Accept": "application/json" },
        cache: "no-store"
      });
      if (!response.ok) throw new Error(`API HTTP ${response.status}`);
      const data = await response.json();
      allDramas = data.items || [];
      if (!preservePage) page = 1;
      render();
      tryRestoreSavedDetailView();
    } catch (error) {
      console.error("Failed to load history:", error);
      countLabel.textContent = "មិនអាចផ្ទុកបាន";
      showStatus("មិនអាចទាញប្រវត្តិរឿងបានទេ។ សូមសាកល្បងម្ដងទៀត។", false, () => loadHistory(true));
      prev.disabled = true;
      next.disabled = true;
    } finally {
      hideAppSplash();
    }
  }

  async function loadFavorites(preservePage = true) {
    countLabel.textContent = "កំពុងផ្ទុក...";
    showStatus("កំពុងទាញយករឿងចូលចិត្ត...", true);
    sectionTitle.textContent = "រឿងចូលចិត្ត";

    try {
      const userId = getUserId();
      let serverFavItems = [];

      if (userId) {
        const res = await fetch(`${API_BASE}/api/favorites/${userId}?_t=${Date.now()}`, {
          method: "GET",
          headers: { "Accept": "application/json" },
          cache: "no-store"
        });
        if (res.ok) {
          const data = await res.json();
          serverFavItems = Array.isArray(data.items) ? data.items : [];
          serverFavItems.forEach(item => setLocalFavoriteState(getTitle(item), true));
        }
      }

      const localSet = getLocalFavoritesSet();
      if (localSet.size > 0 && serverFavItems.length === 0) {
        const dramasRes = await fetch(`${API_URL}?_t=${Date.now()}`, { cache: "no-store" });
        if (dramasRes.ok) {
          const dData = await dramasRes.json();
          const allItems = Array.isArray(dData.items) ? dData.items : [];
          newestCatalogDramas = sortNewestDramasFirst(allItems);
          serverFavItems = newestCatalogDramas.filter(d => localSet.has(getTitle(d)));
        }
      }

      allDramas = serverFavItems;
      if (!preservePage) page = 1;
      render();
      tryRestoreSavedDetailView();
    } catch (error) {
      console.error("Failed to load favorites:", error);
      countLabel.textContent = "មិនអាចផ្ទុកបាន";
      showStatus("មិនអាចទាញបញ្ជីរឿងចូលចិត្តបានទេ។ សូមសាកល្បងម្ដងទៀត។", false, () => loadFavorites(true));
      prev.disabled = true;
      next.disabled = true;
    } finally {
      hideAppSplash();
    }
  }

  search.addEventListener("input", () => {
    showListView(true);
    page = 1;
    savePersistedState({ page: 1, searchQuery: search.value });
    render();
  });

  prev.addEventListener("click", () => {
    if (page > 1) {
      page--;
      savePersistedState({ page });
      render();
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  });

  next.addEventListener("click", () => {
    page++;
    savePersistedState({ page });
    render();
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  function goHomeAction() {
    viewMode = "home";
    currentCategory = "all";
    page = 1;
    search.value = "";
    activeDetailDramaTitle = null;
    activeDetailDramaObj = null;
    savePersistedState({
      page: 1,
      currentCategory: "all",
      viewMode: "home",
      searchQuery: "",
      activeDetailDramaTitle: null,
      scrollY: 0
    });
    document.querySelectorAll('.side-btn').forEach(b => b.classList.remove('active'));
    document.getElementById("home-btn").classList.add('active');
    sectionTitle.textContent = "រឿងទាំងអស់";
    showListView(true);
    loadDramas(false, false);
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  document.getElementById("home-btn").onclick = goHomeAction;

  document.getElementById("focus-search").onclick = () => {
    showListView(true);
    document.querySelectorAll('.side-btn').forEach(b => b.classList.remove('active'));
    document.getElementById("focus-search").classList.add('active');
    window.scrollTo({ top: 0, behavior: "smooth" });
    search.focus();
  };

  document.getElementById("favorites-btn").onclick = () => {
    showListView(true);
    search.value = "";
    viewMode = "favorites";
    page = 1;
    savePersistedState({
      page: 1,
      viewMode: "favorites",
      searchQuery: "",
      activeDetailDramaTitle: null,
      scrollY: 0
    });
    document.querySelectorAll('.side-btn').forEach(b => b.classList.remove('active'));
    document.getElementById("favorites-btn").classList.add('active');
    document.querySelectorAll('.cat-pill').forEach(p => p.classList.remove('active'));
    loadFavorites(false);
    window.scrollTo({ top: 0, behavior: "smooth" });
  };

  document.getElementById("history-btn").onclick = () => {
    showListView(true);
    search.value = "";
    viewMode = "history";
    page = 1;
    savePersistedState({
      page: 1,
      viewMode: "history",
      searchQuery: "",
      activeDetailDramaTitle: null,
      scrollY: 0
    });
    document.querySelectorAll('.side-btn').forEach(b => b.classList.remove('active'));
    document.getElementById("history-btn").classList.add('active');
    document.querySelectorAll('.cat-pill').forEach(p => p.classList.remove('active'));
    loadHistory(false);
    window.scrollTo({ top: 0, behavior: "smooth" });
  };

  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible" && viewMode === "home" && detailView.classList.contains("hidden")) {
      loadDramas(true, true);
    }
  });

  if (viewMode === "history") {
    document.querySelectorAll('.side-btn').forEach(b => b.classList.remove('active'));
    document.getElementById("history-btn").classList.add('active');
    loadHistory(true);
  } else if (viewMode === "favorites") {
    document.querySelectorAll('.side-btn').forEach(b => b.classList.remove('active'));
    document.getElementById("favorites-btn").classList.add('active');
    loadFavorites(true);
  } else {
    loadDramas(true, false);
  }
})();
</script>
</body>
</html>
