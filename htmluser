      window.scrollTo({ top: 0, behavior: "instant" });
    }

    detailTitle.textContent = titleText;
    updateDetailCodeAndDateBadges(initialCode, initialDate, initialCat, initialDuration);

    resetDetailGifPreview();
    detailCover.classList.remove("loaded");
    detailCoverWrap.style.backgroundImage = "none";
    detailSpinner.style.display = "block";

    const initialViews = getRawViews(drama);
    updateDetailViewsUI(initialViews);

    const isFavInitial = Boolean(drama.is_favorite) || isDramaFavoritedLocally(titleText);
    const initialLikes = Number(drama.likes_count || (isFavInitial ? 1 : 0));
    favBtn.dataset.likesCount = String(initialLikes);
