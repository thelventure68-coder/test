    @media (min-width: 720px) {
      .main { max-width: 880px; padding: 0 22px calc(120px + env(safe-area-inset-bottom, 0px)); }
      .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
      .ep-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; }
      .slider-track { --slide-gap: 14px; }
      .detail-cover-wrap { width: 165px; }
    }
