  // ============================================================================
  // INFINITE SLIDER TRACKS
  // ============================================================================

  function getTrackMetrics(trackEl) {
    const firstCard = trackEl.querySelector(".card");
    const count = Number(trackEl.dataset.itemCount || 0);
    if (!firstCard || !count) return null;
    const gap = parseFloat(getComputedStyle(trackEl).gap) || 8;
    const stepWidth = firstCard.getBoundingClientRect().width + gap;
    const singleSetWidth = stepWidth * count;
    return { stepWidth, singleSetWidth, count };
  }

  function normalizeInfiniteLoopScroll(trackEl) {
    if (trackEl.dataset.isLoop !== "1") return;
    const m = getTrackMetrics(trackEl);
    if (!m || m.singleSetWidth <= 0) return;

    if (trackEl.scrollLeft >= m.singleSetWidth * 2 - 4) {
      const prevSnap = trackEl.style.scrollSnapType;
      trackEl.style.scrollSnapType = "none";
      trackEl.scrollLeft -= m.singleSetWidth;
      void trackEl.offsetHeight;
      trackEl.style.scrollSnapType = prevSnap;
    } else if (trackEl.scrollLeft <= 4) {
      const prevSnap = trackEl.style.scrollSnapType;
      trackEl.style.scrollSnapType = "none";
      trackEl.scrollLeft += m.singleSetWidth;
      void trackEl.offsetHeight;
      trackEl.style.scrollSnapType = prevSnap;
    }
  }

  function populateInfiniteTrack(trackEl, dramasList) {
    trackEl.replaceChildren();
    if (!dramasList || dramasList.length === 0) return;

    if (dramasList.length > 3) {
      trackEl.dataset.isLoop = "1";
      trackEl.dataset.itemCount = String(dramasList.length);
      for (let copy = 0; copy < 3; copy++) {
        dramasList.forEach(d => {
          trackEl.appendChild(createDramaCardElement(d, true));
        });
      }
      requestAnimationFrame(() => {
        const m = getTrackMetrics(trackEl);
        if (m && m.singleSetWidth > 0) {
          const prevSnap = trackEl.style.scrollSnapType;
          trackEl.style.scrollSnapType = "none";
          trackEl.scrollLeft = m.singleSetWidth;
          void trackEl.offsetHeight;
          trackEl.style.scrollSnapType = prevSnap;
        }
      });
    } else {
      trackEl.dataset.isLoop = "0";
      trackEl.dataset.itemCount = String(dramasList.length);
      dramasList.forEach(d => {
        trackEl.appendChild(createDramaCardElement(d, true));
      });
      trackEl.scrollLeft = 0;
    }
  }

  function slideTrackByStep(trackEl, direction = 1, isManual = true) {
    const m = getTrackMetrics(trackEl);
    if (!m) return;

    if (isManual) {
      const pauseFn = sliderPauseControllers.get(trackEl);
      if (pauseFn) pauseFn();
    }

    if (trackEl.dataset.isLoop === "1") {
      if (direction > 0 && trackEl.scrollLeft >= m.singleSetWidth * 2 - m.stepWidth * 1.5) {
        const prevSnap = trackEl.style.scrollSnapType;
        trackEl.style.scrollSnapType = "none";
        trackEl.scrollLeft -= m.singleSetWidth;
        void trackEl.offsetHeight;
        trackEl.style.scrollSnapType = prevSnap;
      } else if (direction < 0 && trackEl.scrollLeft <= m.stepWidth * 1.5) {
        const prevSnap = trackEl.style.scrollSnapType;
        trackEl.style.scrollSnapType = "none";
        trackEl.scrollLeft += m.singleSetWidth;
        void trackEl.offsetHeight;
        trackEl.style.scrollSnapType = prevSnap;
      }

      trackEl.scrollBy({ left: direction * m.stepWidth, behavior: "smooth" });
      setTimeout(() => normalizeInfiniteLoopScroll(trackEl), 480);
    } else {
      const maxScroll = trackEl.scrollWidth - trackEl.clientWidth;
      if (direction > 0) {
        if (trackEl.scrollLeft >= maxScroll - 8) {
          trackEl.scrollTo({ left: 0, behavior: "smooth" });
        } else {
          trackEl.scrollBy({ left: m.stepWidth, behavior: "smooth" });
        }
      } else {
        if (trackEl.scrollLeft <= 8) {
          trackEl.scrollTo({ left: maxScroll, behavior: "smooth" });
        } else {
          trackEl.scrollBy({ left: -m.stepWidth, behavior: "smooth" });
        }
      }
    }
  }

  function enableDraggableAndAutoSlide(trackEl, intervalMs = 3200, allowInDetailView = false) {
    if (sliderTimers.has(trackEl)) {
      clearInterval(sliderTimers.get(trackEl));
      sliderTimers.delete(trackEl);
    }

    let isPaused = false;
    let resumeTimeout = null;

    const pauseTemporarily = () => {
      isPaused = true;
      if (resumeTimeout) clearTimeout(resumeTimeout);
      resumeTimeout = setTimeout(() => {
        isPaused = false;
      }, 4500);
    };

    sliderPauseControllers.set(trackEl, pauseTemporarily);

    if (!trackEl.dataset.dragInitialized) {
      trackEl.dataset.dragInitialized = "1";

      let isMouseDown = false;
      let startX = 0;
      let startScrollLeft = 0;
      let scrollEndTimer = null;

      trackEl.addEventListener("scroll", () => {
        if (scrollEndTimer) clearTimeout(scrollEndTimer);
        scrollEndTimer = setTimeout(() => {
          if (!isMouseDown) normalizeInfiniteLoopScroll(trackEl);
        }, 140);
      }, { passive: true });

      trackEl.addEventListener("mousedown", (e) => {
        if (e.button !== 0) return;
        isMouseDown = true;
        trackEl.dataset.dragMoved = "0";
        normalizeInfiniteLoopScroll(trackEl);
        startX = e.pageX - trackEl.offsetLeft;
        startScrollLeft = trackEl.scrollLeft;
        pauseTemporarily();
      });

      window.addEventListener("mousemove", (e) => {
        if (!isMouseDown) return;
        const x = e.pageX - trackEl.offsetLeft;
        const walk = x - startX;
        if (Math.abs(walk) > 6) {
          trackEl.dataset.dragMoved = "1";
          trackEl.classList.add("is-dragging");
          e.preventDefault();
          trackEl.scrollLeft = startScrollLeft - walk;
        }
      });

      window.addEventListener("mouseup", () => {
        if (!isMouseDown) return;
        isMouseDown = false;
        trackEl.classList.remove("is-dragging");
        normalizeInfiniteLoopScroll(trackEl);
        pauseTemporarily();
        setTimeout(() => { trackEl.dataset.dragMoved = "0"; }, 60);
      });

      trackEl.addEventListener("touchstart", () => {
        trackEl.dataset.dragMoved = "0";
        normalizeInfiniteLoopScroll(trackEl);
        pauseTemporarily();
      }, { passive: true });

      trackEl.addEventListener("touchmove", () => { pauseTemporarily(); }, { passive: true });
      trackEl.addEventListener("touchend", () => {
        pauseTemporarily();
        setTimeout(() => normalizeInfiniteLoopScroll(trackEl), 260);
      }, { passive: true });
    }

    const itemCount = Number(trackEl.dataset.itemCount || 0);
    if (itemCount <= 3) return;

    const timer = setInterval(() => {
      if (isPaused || document.hidden) return;
      const isDetailOpen = !detailView.classList.contains("hidden");
      if (allowInDetailView && !isDetailOpen) return;
      if (!allowInDetailView && isDetailOpen) return;
      slideTrackByStep(trackEl, 1, false);
    }, intervalMs);

    sliderTimers.set(trackEl, timer);
  }

