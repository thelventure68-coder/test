  function readLocalManifest() {
    try {
      const raw = localStorage.getItem(MANIFEST_STORAGE_KEY);
      return raw ? JSON.parse(raw) : {};
    } catch (_) {
      return {};
    }
  }

  function writeLocalManifest(manifest) {
    try {
      localStorage.setItem(MANIFEST_STORAGE_KEY, JSON.stringify(manifest));
    } catch (_) {}
  }

  async function syncDramaCoverCacheManifest(activeDramaItems) {
    const oldManifest = readLocalManifest();
    const newManifest = {};

    activeDramaItems.forEach(item => {
      const title = getTitle(item);
      const version = getCoverVersion(item);
      const url = getCover(item);
      newManifest[title] = { version, url };
    });

    const staleEntries = [];
    for (const [oldTitle, oldInfo] of Object.entries(oldManifest)) {
      const currentInfo = newManifest[oldTitle];
      if (!currentInfo || currentInfo.version !== oldInfo.version || currentInfo.url !== oldInfo.url) {
        staleEntries.push({ title: oldTitle, oldInfo });
      }
    }

    writeLocalManifest(newManifest);
    if (staleEntries.length === 0) return;

    staleEntries.forEach(({ oldInfo }) => {
      if (oldInfo && oldInfo.url && memoryBlobUrls.has(oldInfo.url)) {
        try { URL.revokeObjectURL(memoryBlobUrls.get(oldInfo.url)); } catch (_) {}
        memoryBlobUrls.delete(oldInfo.url);
      }
    });

    if (!("caches" in window)) return;
    try {
      const cache = await caches.open(COVER_CACHE_NAME);
      const requests = await cache.keys();
      const deletePromises = [];

      for (const { title, oldInfo } of staleEntries) {
        if (oldInfo && oldInfo.url) deletePromises.push(cache.delete(oldInfo.url));
        const encodedTitlePath = `/api/cover/${encodeURIComponent(title)}`;
        for (const req of requests) {
          if (req.url.includes(encodedTitlePath)) {
            if (memoryBlobUrls.has(req.url)) {
              try { URL.revokeObjectURL(memoryBlobUrls.get(req.url)); } catch (_) {}
              memoryBlobUrls.delete(req.url);
            }
            deletePromises.push(cache.delete(req));
          }
        }
      }
      if (deletePromises.length > 0) await Promise.allSettled(deletePromises);
    } catch (_) {}
  }

  async function loadCoverWithCache(coverUrl) {
    if (memoryBlobUrls.has(coverUrl)) {
      return memoryBlobUrls.get(coverUrl);
    }
    if (!("caches" in window)) return coverUrl;

    try {
      const cache = await caches.open(COVER_CACHE_NAME);
      let cachedResponse = await cache.match(coverUrl);

      if (cachedResponse) {
        const cachedType = (cachedResponse.headers.get("Content-Type") || "").toLowerCase();
        const cachedFallback = cachedResponse.headers.get("X-Cover-Fallback") === "1";
        if (cachedFallback || cachedType.includes("image/svg+xml")) {
          await cache.delete(coverUrl);
          cachedResponse = null;
        }
      }

      if (!cachedResponse) {
        const networkResponse = await fetch(coverUrl, {
          method: "GET",
          mode: "cors",
          credentials: "omit"
        });
        if (!networkResponse.ok) throw new Error(`Image HTTP ${networkResponse.status}`);

        const netType = (networkResponse.headers.get("Content-Type") || "").toLowerCase();
        const isFallback = networkResponse.headers.get("X-Cover-Fallback") === "1" || netType.includes("image/svg+xml");

        if (isFallback) {
          const fallbackBlob = await networkResponse.blob();
          return URL.createObjectURL(fallbackBlob);
        }

        await cache.put(coverUrl, networkResponse.clone());
        cachedResponse = networkResponse;
      }

      const blob = await cachedResponse.blob();
      if ((blob.type || "").toLowerCase().includes("svg")) {
        await cache.delete(coverUrl);
        return URL.createObjectURL(blob);
      }

      const objectUrl = URL.createObjectURL(blob);
      memoryBlobUrls.set(coverUrl, objectUrl);
      return objectUrl;
    } catch (_) {
      return coverUrl;
    }
  }

  async function loadGifPreviewBlob(gifUrl) {
    try {
      const res = await fetch(gifUrl, { method: "GET", mode: "cors", credentials: "omit" });
      if (!res.ok) return null;
      const blob = await res.blob();
      if (!blob || blob.size === 0) return null;
      const objectUrl = URL.createObjectURL(blob);
      return {
        url: objectUrl,
        isVideo: (blob.type || "").toLowerCase().includes("video")
      };
    } catch (_) {
      return null;
    }
  }

  function makePlaceholder() {
    const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="400" height="530">
      <rect width="100%" height="100%" fill="#121212"/>
    </svg>`;
    return "data:image/svg+xml;charset=UTF-8," + encodeURIComponent(svg);
  }

  async function triggerLazyImageLoad(img) {
    if (!img || img.dataset.loadingStarted === "1") return;
    img.dataset.loadingStarted = "1";

    const targetUrl = img.dataset.src;
    const fallbackPlaceholder = img.dataset.placeholder || makePlaceholder();
    const wrap = img.parentElement;

    const finalizeImageReady = () => {
      img.classList.add("loaded");
      wrap?.classList.add("is-ready");
      const sp = wrap?.querySelector(".spinner-ring");
      if (sp) sp.remove();
    };

    if (!targetUrl) {
      img.src = fallbackPlaceholder;
      finalizeImageReady();
      return;
    }

    const safetyTimeout = setTimeout(() => {
      if (!img.classList.contains("loaded")) {
        if (!img.src) img.src = fallbackPlaceholder;
        finalizeImageReady();
      }
    }, 10000);

    img.onload = () => {
      clearTimeout(safetyTimeout);
      finalizeImageReady();
    };

    img.onerror = () => {
      clearTimeout(safetyTimeout);
      img.onerror = null;
      img.src = fallbackPlaceholder;
      finalizeImageReady();
    };

    const resolvedSrc = await loadCoverWithCache(targetUrl);
    img.src = resolvedSrc;

    if (img.complete && img.naturalWidth > 0) {
      clearTimeout(safetyTimeout);
      finalizeImageReady();
    }
  }

  const imageObserver = ("IntersectionObserver" in window)
    ? new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const img = entry.target;
            observer.unobserve(img);
            triggerLazyImageLoad(img);
          }
        });
      }, {
        root: null,
        rootMargin: "320px 320px",
        threshold: 0.01
      })
    : null;

  function observeLazyImage(img, eagerLoad = false) {
    if (eagerLoad || !imageObserver) {
      triggerLazyImageLoad(img);
    } else {
      imageObserver.observe(img);
    }
  }

