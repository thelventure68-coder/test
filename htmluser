<!doctype html>
<html lang="km">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta name="Expires" content="0">
  <meta name="theme-color" content="#000000">
  <title>χƒαη 18 קɭυѕ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Kantumruy+Pro:wght@300;400;500;600;700&family=Koh+Santepheap:wght@400;700;900&display=swap" rel="stylesheet">
  <script src="https://telegram.org/js/telegram-web-app.js" async onload="try{const tg=window.Telegram?.WebApp;if(tg){tg.ready();tg.expand();tg.setHeaderColor?.('#000000');tg.setBackgroundColor?.('#000000');tg.setBottomBarColor?.('#000000');}}catch(e){}"></script>

  <style>
    :root {
      color-scheme: dark;
      --bg: #000000;
      --panel: #080808;
      --panel-hover: #121212;
      --border: #1f1f1f;
      --text: #f2f2f2;
      --muted: #8e8e8e;
      --accent: #d9d9d9;
      --gold: #d4d4d4;
      --rose: #a3a3a3;
    }

    * { box-sizing: border-box; }

    html {
      width: 100%;
      background: #000000;
      overflow-x: hidden;
      overflow-y: scroll;
      scrollbar-gutter: stable;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    html::-webkit-scrollbar,
    body::-webkit-scrollbar {
      width: 0px;
      height: 0px;
      display: none;
    }

    body {
      margin: 0;
      width: 100%;
      background: var(--bg);
      color: var(--text);
      font-family: "Kantumruy Pro", system-ui, -apple-system, "Segoe UI", sans-serif;
      font-size: 14px;
      overflow-x: hidden;
      -webkit-tap-highlight-color: transparent;
    }

    button, input, textarea { font: inherit; }
    button { cursor: pointer; }

    /* =========================================
       XFANSTER Splash Screen (Sword Slash X Animation)
       ========================================= */
    .app-splash {
      position: fixed;
      inset: 0;
      z-index: 99999;
      background-color: #000000;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      opacity: 1;
      visibility: visible;
      will-change: opacity, transform;
      transition: opacity 0.48s cubic-bezier(0.22, 1, 0.36, 1),
                  visibility 0.48s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .app-splash.hide {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .splash-bg-glow {
      position: absolute;
      inset: 0;
      z-index: 1;
      background: radial-gradient(circle at 50% 45%, rgba(255, 255, 255, 0.08) 0%, rgba(0, 0, 0, 1) 68%);
    }

    .splash-content {
      position: relative;
      z-index: 3;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      padding: 24px;
      text-align: center;
    }

    .splash-logo-svg {
      width: 156px;
      height: 156px;
      overflow: visible;
      filter: drop-shadow(0 0 18px rgba(255, 255, 255, 0.35));
      animation: xImpactShake 0.42s cubic-bezier(0.36, 0.07, 0.19, 0.97) 0.36s both,
                 logoGlowPulse 2.2s ease-in-out infinite alternate 0.85s;
    }

    /* ផ្នែកអក្សរ X មុនពេលត្រូវដាវកាត់ */
    .x-frame-top {
      opacity: 0;
      transform-origin: center;
      animation: xFrameAppear 0.28s cubic-bezier(0.22, 1, 0.36, 1) 0.04s forwards,
                 xSplitTopLeft 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.34s forwards;
    }

    .x-frame-bottom {
      opacity: 0;
      transform-origin: center;
      animation: xFrameAppear 0.28s cubic-bezier(0.22, 1, 0.36, 1) 0.04s forwards,
                 xSplitBottomRight 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.34s forwards;
    }

    /* ផ្លែដាវកាប់កាត់ទទឹង (Sword Slash) */
    .x-blade-main {
      opacity: 0;
      transform-box: fill-box;
      transform-origin: 100% 0%;
      animation: swordStrikeMain 0.32s cubic-bezier(0.12, 0.92, 0.24, 1) 0.24s forwards;
    }

    .x-blade-sub {
      opacity: 0;
      transform-box: fill-box;
      transform-origin: 0% 100%;
      animation: swordStrikeSub 0.32s cubic-bezier(0.12, 0.92, 0.24, 1) 0.29s forwards;
    }

    .x-slash-flash {
      opacity: 0;
      pointer-events: none;
      animation: slashFlashGlint 0.45s ease-out 0.26s forwards;
    }

    @keyframes xFrameAppear {
      0% { opacity: 0; transform: scale(0.72); }
      100% { opacity: 1; transform: scale(1); }
    }

    @keyframes swordStrikeMain {
      0% {
        opacity: 0;
        transform: translate(110px, -110px) scale(0.25);
        filter: drop-shadow(0 0 30px #ffffff);
      }
      45% {
        opacity: 1;
        filter: drop-shadow(0 0 28px #ffffff);
      }
      100% {
        opacity: 1;
        transform: translate(0, 0) scale(1);
        filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.7));
      }
    }

    @keyframes swordStrikeSub {
      0% {
        opacity: 0;
        transform: translate(-90px, 90px) scale(0.25);
        filter: drop-shadow(0 0 25px #ffffff);
      }
      50% {
        opacity: 1;
      }
      100% {
        opacity: 1;
        transform: translate(0, 0) scale(1);
      }
    }

    @keyframes xSplitTopLeft {
      0% { transform: translate(0, 0); }
      45% { transform: translate(-4px, -4px); }
      100% { transform: translate(-1.5px, -1.5px); }
    }

    @keyframes xSplitBottomRight {
      0% { transform: translate(0, 0); }
      45% { transform: translate(4px, 4px); }
      100% { transform: translate(1.5px, 1.5px); }
    }

    @keyframes slashFlashGlint {
      0% { opacity: 0; stroke-width: 1; }
      35% { opacity: 1; stroke-width: 14; filter: blur(2px) drop-shadow(0 0 25px #ffffff); }
      100% { opacity: 0; stroke-width: 0; }
    }

    @keyframes xImpactShake {
      0%, 100% { transform: translate(0, 0) scale(1); }
      25% { transform: translate(-3px, 2px) scale(1.04); }
      50% { transform: translate(3px, -2px) scale(1.02); }
      75% { transform: translate(-1.5px, -1px) scale(1.01); }
    }

    @keyframes logoGlowPulse {
      0% { transform: scale(1); filter: drop-shadow(0 0 12px rgba(255, 255, 255, 0.3)); }
      100% { transform: scale(1.04); filter: drop-shadow(0 0 26px rgba(255, 255, 255, 0.78)); }
    }

    .splash-title {
      font-size: 25px;
      font-weight: 700;
      letter-spacing: 2px;
      color: #ffffff;
      margin: 0;
      opacity: 0;
      transform: translateY(10px);
      animation: textFadeUp 0.5s ease-out 0.3s forwards;
    }

    .splash-bar {
      width: 120px;
      height: 2.5px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 99px;
      overflow: hidden;
      position: relative;
      opacity: 0;
      animation: textFadeUp 0.5s ease-out 0.4s forwards;
    }

    .splash-bar::after {
      content: "";
      position: absolute;
      top: 0;
      left: -50%;
      width: 50%;
      height: 100%;
      background: linear-gradient(90deg, transparent, #a3a3a3, #ffffff, transparent);
      border-radius: 99px;
      animation: splashBarSlide 1s ease-in-out infinite;
    }

    .splash-sub {
      color: #888888;
      font-size: 11.5px;
      letter-spacing: 0.5px;
      opacity: 0;
      animation: textFadeUp 0.5s ease-out 0.5s forwards;
    }

    @keyframes textFadeUp {
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes splashBarSlide {
      0% { left: -50%; }
      100% { left: 100%; }
    }

    /* =========================================
       Home Screen Launch Transition
       ========================================= */
    .app {
      display: block;
      min-height: 100dvh;
      opacity: 0;
      transform: scale(0.98);
      transition: opacity 0.42s cubic-bezier(0.22, 1, 0.36, 1),
                  transform 0.42s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .app.app-launched {
      opacity: 1;
      transform: none;
    }

    .line-icon {
      width: 18px;
      height: 18px;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
      fill: none;
      flex-shrink: 0;
      display: inline-block;
      vertical-align: middle;
    }

    .main {
      min-width: 0;
      max-width: 680px;
      margin: 0 auto;
      padding: 0 14px calc(114px + env(safe-area-inset-bottom, 0px));
    }

    /* Sticky Search Bar + Admin Analytics Button */
    .sticky-header {
      position: sticky;
      top: 0;
      z-index: 20;
      background: var(--bg);
      padding: 10px 0 8px;
    }

    .topbar {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 100%;
    }

    .search-wrap {
      flex: 1;
      min-width: 0;
      position: relative;
      margin: 0;
    }

    #search {
      width: 100%;
      height: 46px;
      padding: 0 44px 0 16px;
      background: #121212;
      color: var(--text);
      border: 1px solid #222222;
      border-radius: 14px;
      outline: none;
      font-size: 13.5px;
      transition: border-color .15s, background .15s;
    }

    #search:focus {
      border-color: #484848;
      background: #151515;
    }

    #search::placeholder { color: #787878; }

    .search-icon {
      position: absolute;
      right: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: #888888;
      pointer-events: none;
      display: flex;
      align-items: center;
    }

    .admin-top-btn {
      height: 46px;
      padding: 0 13px;
      border-radius: 14px;
      border: 1px solid #332024;
      background: #140d0f;
      color: #e5e5e5;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 600;
      flex-shrink: 0;
      transition: background .15s, transform .12s;
    }

    .admin-top-btn:hover { background: #1f1216; }
    .admin-top-btn:active { transform: scale(0.95); }

    .content { margin: 6px auto 0; }

    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }

    .section-head h2 {
      margin: 0;
      font-family: "Koh Santepheap", "Kantumruy Pro", serif;
      font-size: 15.5px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 8px;
      color: #ffffff;
    }

    .slider-head-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .slider-sub {
      color: var(--muted);
      font-size: 12px;
    }

    .slider-nav-group {
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .slider-nav-btn {
      width: 27px;
      height: 27px;
      border-radius: 8px;
      border: 1px solid #262626;
      background: #111111;
      color: var(--text);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      transition: background .15s, transform .12s;
    }

    .slider-nav-btn:hover { background: var(--panel-hover); }
    .slider-nav-btn:active { transform: scale(.92); }

    .slider-nav-btn svg {
      width: 14px;
      height: 14px;
      stroke: currentColor;
      stroke-width: 2;
      fill: none;
    }

    #count {
      color: var(--muted);
      font-size: 12px;
    }

    /* Bottom Category Filter Menu */
    .nav-filter-wrap {
      position: relative;
      display: inline-flex;
      align-items: center;
      flex: 0 0 auto;
    }

    .category-filter-panel {
      position: absolute;
      left: 50%;
      bottom: calc(100% + 14px);
      transform: translateX(-50%);
      z-index: 80;
      padding: 7px;
      background: rgba(15, 15, 15, 0.98);
      border: 1px solid #303030;
      border-radius: 14px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.75);
      animation: filterPanelIn .16s ease-out;
    }

    .category-filter-panel::after {
      content: "";
      position: absolute;
      left: 50%;
      bottom: -6px;
      width: 10px;
      height: 10px;
      background: #0f0f0f;
      border-right: 1px solid #303030;
      border-bottom: 1px solid #303030;
      transform: translateX(-50%) rotate(45deg);
    }

    @keyframes filterPanelIn {
      from { opacity: 0; translate: 0 5px; }
      to { opacity: 1; translate: 0 0; }
    }

    .category-filter-panel .category-filter {
      position: relative;
      z-index: 1;
      flex-direction: column;
      align-items: stretch;
      gap: 3px;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      min-width: 132px;
    }

    .category-filter {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 3px;
      min-width: 150px;
      max-width: min(70vw, 260px);
      max-height: min(55vh, 360px);
      overflow-y: auto;
    }

    .category-filter button {
      width: 100%;
      border: 0;
      border-radius: 8px;
      padding: 9px 12px;
      background: transparent;
      color: #929292;
      font-size: 12px;
      line-height: 1.35;
      text-align: left;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: background .18s ease, color .18s ease;
    }

    .category-filter button.active {
      background: #292929;
      color: #ffffff;
      font-weight: 600;
    }

    /* Sliders & 3-Column Drama Grid */
    .slider-block { margin-bottom: 24px; }

    .recommended-block {
      margin-top: 18px;
      padding-top: 18px;
      border-top: 1px solid #1c1c1c;
    }

    .slider-track {
      --slide-gap: 8px;
      display: flex;
      gap: var(--slide-gap);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
      -webkit-overflow-scrolling: touch;
      touch-action: pan-x pan-y;
      cursor: grab;
      user-select: none;
      padding-bottom: 2px;
    }

    .slider-track.is-dragging {
      scroll-snap-type: none;
      scroll-behavior: auto;
      cursor: grabbing;
    }

    .slider-track::-webkit-scrollbar { display: none; }

    .slider-track .card {
      flex: 0 0 calc((100% - (var(--slide-gap) * 2)) / 3);
      max-width: calc((100% - (var(--slide-gap) * 2)) / 3);
      scroll-snap-align: start;
      border-radius: 13px;
      user-select: none;
      -webkit-user-drag: none;
    }

    .slider-track .cover {
      pointer-events: none;
      -webkit-user-drag: none;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }

    .card {
      min-width: 0;
      overflow: hidden;
      padding: 0;
      text-align: left;
      color: var(--text);
      background: #050505;
      border: 1px solid #222222;
      border-radius: 13px;
      transition: background .15s, transform .15s, opacity .15s;
    }

    .card:hover { background: #121212; }
    .card:active { transform: scale(.985); }
    .card:disabled { opacity: 0.6; cursor: wait; }

    .cover-wrap {
      position: relative;
      width: 100%;
      aspect-ratio: 3 / 4;
      background: #121212;
      overflow: hidden;
    }

    .cover-wrap::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.68) 0%,
        rgba(0, 0, 0, 0.16) 32%,
        rgba(0, 0, 0, 0) 60%
      );
      z-index: 3;
      pointer-events: none;
    }

    .spinner-ring {
      position: absolute;
      inset: 0;
      margin: auto;
      width: 28px;
      height: 28px;
      border: 2.5px solid rgba(255, 255, 255, 0.14);
      border-top-color: #888888;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      z-index: 1;
    }

    .btn-mini-spinner {
      width: 14px;
      height: 14px;
      border: 2px solid rgba(255, 255, 255, 0.25);
      border-top-color: #ffffff;
      border-radius: 50%;
      animation: spin 0.75s linear infinite;
      flex-shrink: 0;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .cover {
      position: relative;
      z-index: 2;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transform: scale(1.025);
      transition: opacity 0.38s cubic-bezier(0.22, 1, 0.36, 1),
                  transform 0.44s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .cover.loaded {
      opacity: 1;
      transform: scale(1);
    }

    .cover-play-icon {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 30px;
      height: 30px;
      background: transparent;
      border: none;
      padding: 0;
      margin: 0;
      z-index: 4;
      pointer-events: none;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.75));
      transition: opacity 0.25s ease, transform 0.2s ease;
    }

    .cover-wrap.is-ready .cover-play-icon { opacity: 0.88; }

    .card:hover .cover-play-icon,
    .card:active .cover-play-icon {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.08);
    }

    .cover-play-icon svg {
      width: 30px;
      height: 30px;
      stroke: #ffffff;
      stroke-width: 1.75;
      stroke-linecap: round;
      stroke-linejoin: round;
      fill: none;
      display: block;
    }

    .cover-views {
      position: absolute;
      left: 7px;
      bottom: 6px;
      z-index: 4;
      display: inline-flex;
      align-items: center;
      gap: 3.5px;
      background: transparent;
      border: none;
      color: #ffffff;
      font-size: 10.5px;
      font-weight: 500;
      line-height: 1;
      pointer-events: none;
      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.95);
      opacity: 0.95;
    }

    .cover-views svg {
      width: 12.5px;
      height: 12.5px;
      stroke: #ffffff;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
      fill: none;
      flex-shrink: 0;
      display: block;
      filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.85));
    }

    .cover-duration {
      position: absolute;
      right: 6px;
      bottom: 5px;
      z-index: 4;
      display: inline-flex;
      align-items: center;
      gap: 3px;
      padding: 2px 5.5px;
      border-radius: 5px;
      background: rgba(0, 0, 0, 0.78);
      border: 1px solid rgba(255, 255, 255, 0.14);
      color: #ffffff;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 9.5px;
      font-weight: 600;
      line-height: 1.1;
      pointer-events: none;
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }

    .card-body { padding: 7px 7px 8px; }

    .card-title {
      font-family: "Koh Santepheap", "Kantumruy Pro", serif;
      font-size: 12px;
      font-weight: 700;
      line-height: 1.45;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      display: block;
    }

    .card-meta {
      margin-top: 4px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 4px;
      color: var(--muted);
      font-size: 9.5px;
      white-space: nowrap;
      overflow: hidden;
    }

    .card-code-tag {
      color: #d4d4d4;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 9.5px;
      font-weight: 600;
      flex-shrink: 0;
    }

    .card-date-tag {
      color: #7d7d7d;
      font-size: 9px;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .status {
      grid-column: 1 / -1;
      padding: 42px 15px;
      text-align: center;
      color: var(--muted);
      line-height: 1.8;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
    }

    .page-spinner {
      width: 38px;
      height: 38px;
      border: 3px solid rgba(255, 255, 255, 0.14);
      border-top-color: #888888;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    .retry {
      margin-top: 6px;
      border: 1px solid var(--border);
      border-radius: 9px;
      background: var(--panel);
      color: var(--text);
      padding: 10px 16px;
    }

    .pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 15px;
      padding: 25px 0 20px;
    }

    .page-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 1px solid var(--border);
      background: var(--panel);
      color: var(--text);
      padding: 9px 15px;
      border-radius: 10px;
    }

    .page-btn:disabled { opacity: .35; cursor: default; }
    #page-label { color: var(--muted); font-size: 12px; }

    /* =========================================
       Floating Pill Bottom Tab Bar
       ========================================= */
    .bottom-fade-mask {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
